# A sieve of Eratosthenes. Catmint has no array type: List is a growable
# array of object references, so every entry is a boxed Integer on the heap.
# This is the benchmark catmint is worst at, and it is here to show by how
# much.
class Main from IO
  def main:
    Int limit = 200000
    List flags
    Int i = 0
    while i < limit:
      flags.append(1)
      i = i + 1
    end

    Int p = 2
    while p * p < limit:
      Int mark = flags.get(p)
      if mark == 1:
        Int m = p * p
        while m < limit:
          flags.set(m, 0)
          m = m + p
        end
      end
      p = p + 1
    end

    Int count = 0
    Int n = 2
    while n < limit:
      Int flag = flags.get(n)
      count = count + flag
      n = n + 1
    end
    out("${count}\n")
  end
end
