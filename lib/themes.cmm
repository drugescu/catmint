  # The theme with this name, or null.
  static def Theme named(String name):
    List list = Themes.all()
    Int i = 0
    while i < list.len():
      Theme t = list.get(i)
      if t.name.equals(name):
        return t
      end
      i = i + 1
    end
    return null
  end

  # The names, in the order they are offered.
  static def List names:
    List list = Themes.all()
    List result = new List()
    Int i = 0
    while i < list.len():
      Theme t = list.get(i)
      result.append(t.name)
      i = i + 1
    end
    return result
  end

  # Where "toggle dark and light" goes from this theme.
  static def Theme pairOf(Theme t):
    Theme other = Themes.named(t.pair)
    if other == null:
      return t
    end
    return other
  end
