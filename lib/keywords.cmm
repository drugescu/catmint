# Generated by tools/make_keywords.py from catmint-lex/catmint.l -- do not edit.
#
# The words the lexer treats as keywords, so that the editor colours exactly
# those. test.sh runs `make_keywords.py --check`, which fails if this file and
# the lexer disagree.
class Keywords
  # Every keyword, each with a space on both sides.
  static def String all:
    return " "
      + "using "
      + "class "
      + "interface "
      + "does "
      + "from "
      + "return "
      + "self "
      + "null "
      + "constructor "
      + "new "
      + "constexpr "
      + "def "
      + "static "
      + "abstract "
      + "extern "
      + "struct "
      + "union "
      + "unsafe "
      + "var "
      + "if "
      + "for "
      + "in "
      + "is "
      + "and "
      + "or "
      + "do "
      + "while "
      + "break "
      + "continue "
      + "try "
      + "catch "
      + "throw "
      + "defer "
      + "spawn "
      + "then "
      + "elif "
      + "else "
      + "end "
  end

  # 1 if word is a keyword, else 0.
  static def Int has(String word):
    if Keywords.all().indexOf(" " + word + " ") >= 0 and word.len() > 0:
      return 1
    end
    return 0
  end
end
