# Running catmintc on the file being edited: finding the compiler, and what to give it.
#
# Where the compiler is, when --catmintc did not say: started from the repository,
# it is ./catmintc; started as examples/pad/pad from anywhere, it is two folders up
# from this program; otherwise whatever is on the PATH. The library folder beside a
# compiler found by path is passed with it, so a program that says `using sdl`
# builds without being told where sdl is. The program is built next to its source,
# with its name less the .cm; its output is read a line at a time into the panel.

using files
using outputpanel

class Builder from Object
  String compiler = ""
  List includes = null

  constructor():
    includes = new List()
  end

  def Void locate(String argv0):
    String found = ""
    if File.exists("catmintc") == 1 and Files.isDirectory("catmintc") == 0:
      found = "./catmintc"
    else
      Int slash = 0 - 1
      Int i = 0
      while i < argv0.len():
        if argv0.at(i) == 47:
          slash = i
        end
        i = i + 1
      end
      if slash >= 0:
        String near = argv0.substr(0, slash) + "/../../catmintc"
        if File.exists(near) == 1:
          found = near
        end
      end
    end
    if found.len() == 0:
      found = "catmintc"
    end
    compiler = found
    if includes.len() == 0:
      if found.len() > 8 and File.exists(found.substr(0, found.len() - 8) + "lib/sdl.cmm") == 1:
        includes.append(found.substr(0, found.len() - 8) + "lib")
      elif File.exists("lib/sdl.cmm") == 1:
        includes.append("lib")
      end
    end
  end

  # Where a build of this file is put: its name less the extension.
  def String outputFor(String path):
    if path.len() > 3 and path.substr(path.len() - 3, path.len()).equals(".cm"):
      return path.substr(0, path.len() - 3)
    end
    return path + ".out"
  end

  # Compile path, putting what the compiler says in the panel. How it ended: 0 is
  # a program, 127 is that there was no compiler to run.
  def Int build(String path, OutputPanel panel):
    List args = new List()
    args.append(compiler)
    Int i = 0
    while i < includes.len():
      args.append("-I")
      args.append(includes.get(i))
      i = i + 1
    end
    args.append(path)
    args.append("-o")
    args.append(outputFor(path))
    panel.clear()
    Process p = new Process()
    p.openArgs(args)
    while p.eof() == 0:
      panel.add(p.readLine())
    end
    Int code = p.finish()
    if code == 127:
      panel.add("could not run ${compiler}")
    end
    return code
  end
end
