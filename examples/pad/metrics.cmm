# Where things are in the window: the sizes and positions every other part of pad
# agrees on, in one place and with no state of its own to get out of step.
#
# A cell is one character: 8 x 16 pixels, times `scale`. A row is 1.4 cells high.
# From the top, a window is: the strip of tabs (when there is more than one file),
# the text, the output panel (when it is open), and the status line. Down the left,
# when it is showing, is the file explorer (`sidebarCells` wide) and all of that sits
# to the right of it. The text begins to the right of a gutter of two cells, the line
# numbers, and two more. The owner sets `scale`, `width`, `height`, `tabRows` (0 or 1),
# `panelRows` (0 or 8) and `sidebarCells` when they change; everything else is worked
# out from those.

using font

class Metrics from Object
  Int scale = 1
  Int width
  Int height
  Int tabRows
  Int panelRows
  # The file explorer down the left, in cells: 0 when it is not showing.
  Int sidebarCells

  def Int cell:
    return 8 * scale
  end

  # A line is 1.4 times the height of a glyph.
  def Int rowHeight:
    return 16 * scale * 7 / 5
  end

  # How far a glyph sits down in its row.
  def Int inset:
    return (rowHeight() - 16 * scale) / 2
  end

  # How many digits the line numbers are given room for, at least three.
  def Int digits(Int lines):
    Int n = lines
    Int d = 3
    while n >= 1000:
      n = n / 10
      d = d + 1
    end
    return d
  end

  # Where the editor begins: past the explorer, if it is showing.
  def Int areaLeft:
    return sidebarCells * cell()
  end

  # How many rows the explorer has room for: down to the status line.
  def Int sidebarRows:
    return (height - rowHeight()) / rowHeight()
  end

  # Two cells of margin, the line number, two cells more.
  def Int textLeft(Int lines):
    return areaLeft() + (4 + digits(lines)) * cell()
  end

  def Int tabsHeight:
    return tabRows * rowHeight()
  end

  def Int panelHeight:
    if panelRows > 0:
      return panelRows * rowHeight() + 1
    end
    return 0
  end

  def Int viewHeight:
    return height - tabsHeight() - rowHeight() - panelHeight()
  end

  def Int viewRows:
    Int rows = viewHeight() / rowHeight()
    if rows < 1:
      rows = 1
    end
    return rows
  end

  def Int visibleCols(Int lines):
    Int cols = (width - textLeft(lines)) / cell()
    if cols < 4:
      cols = 4
    end
    return cols
  end

  # The command palette: 64 cells, or the window less a cell at each side.
  def Int paletteWidth:
    Int w = 64 * cell()
    if w > width - 2 * cell():
      w = width - 2 * cell()
    end
    return w
  end

  # A tab: two cells of margin, the name, two cells, the closing x, a cell.
  def Int tabWidth(String label):
    return (Font.cells(label) + 6) * cell()
  end

  # The line of the text under a pixel row, given the first line shown.
  def Int rowAt(Int y, Int top):
    return top + (y - tabsHeight()) / rowHeight()
  end

  # The column under a pixel, to the nearest edge between characters.
  def Int colAt(Int x, Int lines, Int scrollX):
    Int c = (x - textLeft(lines) + scrollX * cell() + cell() / 2) / cell()
    if x < textLeft(lines):
      c = 0 - 1
    end
    if c < 0:
      c = 0
    end
    return c
  end
end
