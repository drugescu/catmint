# F7 saves what has been changed before it builds: the file on disk has the
# comment line typed above the program, and the program, with it, still builds.
# files good.cm=class Main from IO\n  def main:\n    out("hi")\n  end\nend\n
# open good.cm
# args --catmintc @ROOT@/catmintc
# frames 6
# file good.cm=# x\nclass Main from IO\n  def main:\n    out("hi")\n  end\nend\n
# expect modified 0
# expect message built good
1 text # x
2 key enter
3 key f7
4 wait idle
