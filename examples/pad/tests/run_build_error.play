# A program that does not build is not run: the panel keeps what the compiler said, and
# nothing is left running.
# files bad.cm=class Main from IO\n  def main:\n    Int x = \n  end\nend\n
# open bad.cm
# args --catmintc @ROOT@/catmintc
# frames 4
# expect message build failed
# expect runner 0
# expect panel 1 2
# absent finished
1 key f5
2 wait idle
