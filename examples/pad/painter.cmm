# Drawing pad's window. It holds the renderer and the font and nothing about the
# program: what to draw, and in which colours and sizes, comes in as arguments,
# so it can be read -- and changed -- without knowing how files, tabs or the
# palette work. `begin` says which theme and measures this frame uses.
#
# Colours are the theme's; positions and sizes are Metrics'. Text is drawn a run
# at a time in the colour of what it is, using lib/highlight.cmm.

using sdl
using font
using theme
using editor
using highlight
using palette
using buildlog
using metrics

class Painter from Object
  Renderer view = null
  Font font = null
  Theme t = null
  Metrics m = null

  constructor(Renderer r):
    view = r
    font = new Font(r)
  end

  def Void begin(Theme theme, Metrics measures):
    t = theme
    m = measures
  end

  def Void color(Int c):
    view.setColor(Theme.red(c), Theme.green(c), Theme.blue(c))
  end

  def Void ink(String s, Int x, Int y, Int c):
    font.draw(s, x, y + m.inset(), m.scale, Theme.red(c), Theme.green(c), Theme.blue(c))
  end

  def Void hairline(Int x, Int y, Int w, Int c):
    color(c)
    view.fillRect(x, y, w, 1)
  end

  def Void clear:
    color(t.ground)
    view.fillRect(0, 0, m.width, m.height)
  end

  def Void present:
    view.present()
  end

  # One line of code, a run at a time, each in the colour of what it is.
  def Void code(String text, Int x, Int y):
    Bytes kinds = Highlight.kinds(text)
    Int n = text.len()
    Int i = 0
    Int cells = 0
    while i < n:
      Int kind = kinds.get(i)
      Int j = i
      while j < n and kinds.get(j) == kind:
        j = j + 1
      end
      String run = text.substr(i, j)
      Int w = Font.cells(run)
      Int px = x + cells * m.cell()
      if px < m.width:
        ink(run, px, y, Highlight.colour(t, kind))
      end
      cells = cells + w
      i = j
    end
  end

  # The text of one file: the current line's band, the selection, the line
  # numbers, the code, and the caret when `caret` says to draw it.
  def Void text(Editor ed, Int scrollX, Int caret):
    Int rows = m.viewRows()
    Int left = m.textLeft(ed.buf.lines())
    Int cursorRow = ed.buf.lineOf(ed.cursor)
    Int a = ed.selStart()
    Int b = ed.selEnd()
    Int i = 0
    while i < rows:
      Int row = ed.top + i
      if row < ed.buf.lines():
        Int y = m.tabsHeight() + i * m.rowHeight()
        if row == cursorRow:
          color(t.line)
          view.fillRect(0, y, m.width, m.rowHeight())
        end
        # The selection on this row, and the newline if it goes on past it.
        Int ls = ed.buf.lineStart(row)
        Int le = ed.textEnd(row)
        if b > ls and a <= le and a != b:
          Int from0 = a
          if from0 < ls:
            from0 = ls
          end
          Int to0 = b
          if to0 > le:
            to0 = le
          end
          Int startCol = ed.column(from0)
          Int cols = ed.column(to0) - startCol
          if b > le:
            cols = cols + 1
          end
          color(t.selection)
          view.fillRect(left + (startCol - scrollX) * m.cell(), y, cols * m.cell(), m.rowHeight())
        end
        String number = "${row + 1}"
        Int numberColor = t.dim
        if row == cursorRow:
          numberColor = t.text
        end
        ink(number, (2 + m.digits(ed.buf.lines()) - number.len()) * m.cell(), y, numberColor)
        view.clip(left, y, m.width - left, m.rowHeight())
        code(ed.buf.lineText(row), left - scrollX * m.cell(), y)
        view.unclip()
      end
      i = i + 1
    end
    if caret == 1 and cursorRow >= ed.top and cursorRow < ed.top + rows:
      color(t.accent)
      view.fillRect(left + (ed.column(ed.cursor) - scrollX) * m.cell(), m.tabsHeight() + (cursorRow - ed.top) * m.rowHeight(), 2 * m.scale, m.rowHeight())
    end
  end

  # The strip of tabs, from the first one shown; the one in front joins the page.
  def Void tabs(List labels, Int current, Int first):
    Int h = m.rowHeight()
    color(t.panel)
    view.fillRect(0, 0, m.width, h)
    Int x = 0
    Int i = first
    while i < labels.len() and x < m.width:
      String label = labels.get(i)
      Int w = m.tabWidth(label)
      view.clip(x, 0, w, h)
      if i == current:
        color(t.ground)
        view.fillRect(x, 0, w, h - 1)
        hairline(x, h - 1, w, t.accent)
        ink(label, x + 2 * m.cell(), 0, t.text)
      else
        ink(label, x + 2 * m.cell(), 0, t.dim)
      end
      ink("x", x + w - 2 * m.cell(), 0, t.dim)
      view.unclip()
      x = x + w
      i = i + 1
    end
  end

  # What the compiler said, a line that names a place in the error colour.
  def Void panel(List lines):
    Int top = m.tabsHeight() + m.viewHeight()
    color(t.panel)
    view.fillRect(0, top, m.width, m.panelHeight())
    hairline(0, top, m.width, t.dim)
    Int i = 0
    while i < m.panelRows and i < lines.len():
      String line = lines.get(i)
      Int c = t.text
      if BuildLog.line(line) > 0:
        c = t.error
      end
      view.clip(0, top + 1, m.width, m.panelHeight() - 1)
      ink(line, m.cell(), top + 1 + i * m.rowHeight(), c)
      view.unclip()
      i = i + 1
    end
  end

  # The last row: the file's name, a note, and where the cursor is.
  def Void status(String name, String message, Int line, Int col):
    Int y = m.height - m.rowHeight()
    color(t.panel)
    view.fillRect(0, y, m.width, m.rowHeight())
    ink(name, m.cell(), y, t.text)
    if message.len() > 0:
      ink(message, m.cell() * (3 + Font.cells(name)), y, t.dim)
    end
    String where = "${line}:${col}"
    ink(where, m.width - m.cell() * (1 + where.len()), y, t.dim)
  end

  # The palette: a field over a list, the highlighted row banded, each with its hint.
  def Void palette(Palette pal, Int caret):
    Int w = m.paletteWidth()
    Int x = (m.width - w) / 2
    Int y = m.rowHeight()
    Int shown = pal.results.len()
    Int h = (1 + shown) * m.rowHeight() + 1
    color(t.panel)
    view.fillRect(x, y, w, h)
    hairline(x, y, w, t.dim)
    hairline(x, y + h, w, t.dim)
    color(t.dim)
    view.fillRect(x, y, 1, h)
    view.fillRect(x + w, y, 1, h + 1)
    ink(pal.prompt, x + m.cell(), y, t.dim)
    Int fieldX = x + m.cell() * (2 + Font.cells(pal.prompt))
    view.clip(x, y, w, m.rowHeight())
    ink(pal.field.buf.text(), fieldX, y, t.text)
    if caret == 1:
      color(t.accent)
      view.fillRect(fieldX + pal.field.column(pal.field.cursor) * m.cell(), y + 1, 2 * m.scale, m.rowHeight() - 2)
    end
    view.unclip()
    hairline(x, y + m.rowHeight() - 1, w, t.accent)
    Int i = 0
    while i < shown:
      Int index = pal.results.get(i)
      Int ry = y + (1 + i) * m.rowHeight()
      if i == pal.selected:
        color(t.selection)
        view.fillRect(x + 1, ry, w - 1, m.rowHeight())
      end
      String name = pal.names.get(index)
      view.clip(x, ry, w, m.rowHeight())
      ink(name, x + m.cell(), ry, t.text)
      if index < pal.hints.len():
        String hint = pal.hints.get(index)
        ink(hint, x + w - m.cell() * (1 + Font.cells(hint)), ry, t.dim)
      end
      view.unclip()
      i = i + 1
    end
  end
end
