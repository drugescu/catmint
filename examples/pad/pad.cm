# pad: a small editor for catmint programs.
#
#   pad [file] [--catmintc path] [-I dir] [--themes dir] ...
#
# F5 needs catmintc: started in the repository it is ./catmintc, run as
# examples/pad/pad it is found from there, else it is looked for on the PATH.
#
# Text is the interface. There is no menu bar, no dialog, no tab strip and
# nothing to configure: one command palette (Ctrl P, or Cmd on a Mac) does what
# those do -- it runs commands, opens files by a fragment of their path, finds,
# replaces and goes to a line -- and one line at the bottom says where you are.
# F5 saves and builds with catmintc and shows what it said in a panel; a click
# on a line that names a place goes there.
#
#   Ctrl P  commands        Ctrl O  open a file      Ctrl S  save
#   Ctrl F  find            Ctrl H  replace          Ctrl L  go to a line
#   F3      next match      F5      build            Ctrl T  dark / light
#   Ctrl =  bigger text     Ctrl -  smaller text     Ctrl Q  quit
#
# One file at a time. A tab character is drawn as ?, and a string that runs
# over a newline is coloured on its first line only. Open lists the files
# below the directory pad was started in (six levels, five thousand files,
# nothing hidden), so start it in a project, not in a home directory.
#
# Built on the library, not on this file: the text is lib/textbuffer.cmm, what
# is done to it lib/editor.cmm, the palette lib/palette.cmm over lib/fuzzy.cmm,
# the colours lib/theme.cmm, files lib/files.cmm. What is here is drawing and
# turning events into those.
#
# Testing without a person: `--play script --frames N --shot out.bmp` feeds
# scripted input to the same code, draws N frames, saves the last, and prints
# the state; see examples/pad/play.sh.

using sdl
using font
using theme
using editor
using highlight
using themes
using base16
using settings
using palette
using files
using buildlog
using outputpanel
using builder
using metrics
using painter
using playscript

# A file being edited, parked while another tab is in front. The one in front
# lives in Pad's own ed, path and scrollX, so everything that works on "the
# document" works on it without asking which; switching swaps them with these.
class Doc from Object
  Editor ed = null
  String path = ""
  Int scrollX
end

class Pad from IO
  Sdl sdl = null
  Window win = null
  Renderer view = null
  Painter painter = null
  Metrics m = null
  Theme t = null
  List themeList = null
  Theme themeBefore = null
  String configDir = ""
  String themeDir = ""
  Editor ed = null
  List docs = null
  Int current
  Int firstTab
  Palette pal = null
  String path = ""
  String message = ""
  Builder builder = null
  List recents = null
  OutputPanel output = null
  Int scrollX
  Int dragging
  Int lastClick
  Int clickedRow = 0 - 1
  Int clickedCol = 0 - 1
  Int caretOn = 1
  Int lastBlink
  Int dirty = 1
  Int quitting
  String armed = ""
  String was = ""
  String needle = ""
  Int findOrigin
  List commandIds = null
  List commandNames = null
  List commandHints = null

  constructor(Sdl s, Window w, Renderer r):
    sdl = s
    win = w
    view = r
    painter = new Painter(r)
    m = new Metrics()
    t = Theme.dark()
    configDir = Settings.dir()
    if configDir.len() > 0:
      themeDir = configDir + "/themes"
    end
    ed = new Editor()
    Doc first = new Doc()
    first.ed = ed
    docs = new List()
    docs.append(first)
    pal = new Palette()
    builder = new Builder()
    recents = new List()
    output = new OutputPanel()
    commandIds = new List()
    commandNames = new List()
    commandHints = new List()
    m.width = w.width()
    m.height = w.height()
    command("save", "Save", "Ctrl S")
    command("open", "Open file", "Ctrl O")
    command("new", "New file", "Ctrl N")
    command("close", "Close tab", "Ctrl W")
    command("nexttab", "Next tab", "Ctrl Tab")
    command("prevtab", "Previous tab", "Ctrl Shift Tab")
    command("find", "Find", "Ctrl F")
    command("findnext", "Find next", "F3")
    command("findprev", "Find previous", "Shift F3")
    command("replace", "Replace", "Ctrl H")
    command("line", "Go to line", "Ctrl L")
    command("build", "Build", "F5")
    command("theme", "Toggle dark and light", "Ctrl T")
    command("themes", "Color theme...", "")
    command("bigger", "Bigger text", "Ctrl =")
    command("smaller", "Smaller text", "Ctrl -")
    command("undo", "Undo", "Ctrl Z")
    command("redo", "Redo", "Ctrl Shift Z")
    command("all", "Select all", "Ctrl A")
    command("cut", "Cut", "Ctrl X")
    command("copy", "Copy", "Ctrl C")
    command("paste", "Paste", "Ctrl V")
    command("quit", "Quit", "Ctrl Q")
  end

  def Void command(String id, String name, String hint):
    commandIds.append(id)
    commandNames.append(name)
    commandHints.append(hint)
  end

  # ---- themes -----------------------------------------------------------------

  # The theme the settings name, if it can still be found: built in, or in the
  # themes folder. Anything else is the default, not an error.
  def Void restoreTheme:
    String wanted = Settings.get(configDir, "theme", "")
    if wanted.len() > 0:
      Theme found = Themes.named(wanted)
      if found == null and themeDir.len() > 0:
        List all = Base16.withFolder(themeDir)
        Int i = 0
        while i < all.len():
          Theme candidate = all.get(i)
          if candidate.name.equals(wanted):
            found = candidate
          end
          i = i + 1
        end
      end
      if found != null:
        t = found
      end
    end
  end

  def Void rememberTheme:
    Settings.put(configDir, "theme", t.name)
  end

  # The list of themes: the built-in ones, then any in the themes folder, with
  # the one in use highlighted.
  def Void openThemes:
    themeBefore = t
    if themeDir.len() > 0:
      themeList = Base16.withFolder(themeDir)
    else
      themeList = Themes.all()
    end
    List names = new List()
    List kinds = new List()
    Int i = 0
    while i < themeList.len():
      Theme each = themeList.get(i)
      names.append(each.name)
      if each.isDark == 1:
        kinds.append("dark")
      else
        kinds.append("light")
      end
      i = i + 1
    end
    pal.open(Palette.themeMode(), "theme", names, kinds)
    pal.rows = 12
    pal.refresh()
    i = 0
    while i < pal.results.len():
      Int which = pal.results.get(i)
      String name = names.get(which)
      if name.equals(t.name):
        pal.selected = i
      end
      i = i + 1
    end
  end

  # While the list is open, the highlighted theme is the one on screen.
  def Void previewTheme:
    if pal.mode == Palette.themeMode():
      Int which = pal.chosen()
      if which >= 0:
        Theme shown = themeList.get(which)
        t = shown
      end
    end
  end

  # Close the palette. A list of themes that is dismissed puts back what it found.
  def Void closePalette:
    if pal.mode == Palette.themeMode():
      t = themeBefore
    end
    pal.close()
  end

  # ---- measures ---------------------------------------------------------------

  # Scroll just far enough that the cursor can be seen.
  def Void reveal:
    ed.reveal(m.viewRows())
    Int c = ed.column(ed.cursor)
    Int cols = m.visibleCols(ed.buf.lines()) - 2
    if c < scrollX:
      scrollX = c
    elif c >= scrollX + cols:
      scrollX = c - cols + 1
    end
    dirty = 1
  end

  def Void wake:
    caretOn = 1
    lastBlink = sdl.ticks()
    dirty = 1
  end

  # ---- drawing ----------------------------------------------------------------

  # ---- tabs ---------------------------------------------------------------------

  def String baseName(String p):
    Int slash = 0 - 1
    Int i = 0
    while i < p.len():
      if p.at(i) == 47:
        slash = i
      end
      i = i + 1
    end
    return p.substr(slash + 1, p.len())
  end

  # What a tab says: the file's name, and " *" if it has changes.
  def String tabLabel(Int i):
    String name = path
    Int changed = ed.buf.modified()
    if i != current:
      Doc d = docs.get(i)
      name = d.path
      changed = d.ed.buf.modified()
    end
    if name.len() == 0:
      name = "(no name)"
    else
      name = baseName(name)
    end
    if changed == 1:
      name = name + " *"
    end
    return name
  end

  # Scroll the strip just far enough that the tab in front is all there.
  def Void ensureTabVisible:
    if current < firstTab:
      firstTab = current
    end
    Int used = 0
    Int i = firstTab
    while i <= current:
      used = used + tabWidth(i)
      i = i + 1
    end
    while used > m.width and firstTab < current:
      used = used - tabWidth(firstTab)
      firstTab = firstTab + 1
    end
  end

  # The tab under a pixel of the strip, or -1; and whether it is on the x.
  def Int tabAt(Int px):
    Int x = 0
    Int i = firstTab
    while i < docs.len():
      Int w = tabWidth(i)
      if px >= x and px < x + w:
        return i
      end
      x = x + w
      i = i + 1
    end
    return 0 - 1
  end

  def Int onTabClose(Int px, Int index):
    Int x = 0
    Int i = firstTab
    while i < index:
      x = x + tabWidth(i)
      i = i + 1
    end
    if px >= x + tabWidth(index) - 2 * m.cell() and px < x + tabWidth(index) - m.cell():
      return 1
    end
    return 0
  end

  # Put the tab in front into its slot, and take another out of its.
  def Void park:
    Doc d = docs.get(current)
    d.ed = ed
    d.path = path
    d.scrollX = scrollX
  end

  def Void unpark(Int i):
    Doc d = docs.get(i)
    current = i
    ed = d.ed
    path = d.path
    scrollX = d.scrollX
    dragging = 0
    ensureTabVisible()
    if path.len() == 0:
      win.title("pad")
    else
      win.title("pad - ${path}")
    end
  end

  def Void switchTo(Int i):
    if i >= 0 and i < docs.len() and i != current:
      park()
      unpark(i)
      reveal()
    end
  end

  # A tab of its own, in front.
  def Void newDoc:
    park()
    Doc d = new Doc()
    d.ed = new Editor()
    docs.append(d)
    unpark(docs.len() - 1)
    reveal()
  end

  # 1 if any tab has changes that are not saved.
  def Int anyModified:
    if ed.buf.modified() == 1:
      return 1
    end
    Int i = 0
    while i < docs.len():
      if i != current:
        Doc d = docs.get(i)
        if d.ed.buf.modified() == 1:
          return 1
        end
      end
      i = i + 1
    end
    return 0
  end

  # The tab, if the file is open already; else -1.
  def Int docWithPath(String p):
    if path.equals(p):
      return current
    end
    Int i = 0
    while i < docs.len():
      Doc d = docs.get(i)
      if i != current and d.path.equals(p):
        return i
      end
      i = i + 1
    end
    return 0 - 1
  end

  # Close the tab in front and go to the one before it. With changes it says so
  # first, and the same again discards them.
  def Void closeCurrent:
    if mayDiscard("close") == 1:
      List kept = new List()
      Int i = 0
      while i < docs.len():
        if i != current:
          kept.append(docs.get(i))
        end
        i = i + 1
      end
      Int next = current - 1
      if kept.len() == 0:
        Doc blank = new Doc()
        blank.ed = new Editor()
        kept.append(blank)
      end
      if next < 0:
        next = 0
      end
      docs = kept
      firstTab = 0
      unpark(next)
      reveal()
    end
  end

  # Tell the measures what the window now holds: a strip of tabs when there are
  # two files or more, the output panel when it is open.
  def Void layout:
    m.tabRows = 0
    if docs.len() >= 2:
      m.tabRows = 1
    end
    m.panelRows = 0
    if output.open == 1:
      m.panelRows = 8
    end
  end

  def Int tabWidth(Int i):
    return m.tabWidth(tabLabel(i))
  end

  def List tabLabels:
    List labels = new List()
    Int i = 0
    while i < docs.len():
      labels.append(tabLabel(i))
      i = i + 1
    end
    return labels
  end

  def String statusName:
    String name = path
    if name.len() == 0:
      name = "(no name)"
    end
    if ed.buf.modified() == 1:
      name = name + " *"
    end
    return name
  end

  def Void draw:
    layout()
    painter.begin(t, m)
    painter.clear()
    Int caret = 0
    if caretOn == 1 and pal.isOpen() == 0:
      caret = 1
    end
    painter.text(ed, scrollX, caret)
    if docs.len() >= 2:
      ensureTabVisible()
      painter.tabs(tabLabels(), current, firstTab)
    end
    if output.open == 1:
      painter.panel(output.lines)
    end
    painter.status(statusName(), message, ed.line(), ed.col())
    if pal.isOpen() == 1:
      painter.palette(pal, caretOn)
    end
    painter.present()
    dirty = 0
  end

  # ---- files ------------------------------------------------------------------------

  def Void remember(String p):
    List kept = new List()
    kept.append(p)
    Int i = 0
    while i < recents.len():
      String r = recents.get(i)
      if r != p:
        kept.append(r)
      end
      i = i + 1
    end
    recents = kept
  end

  # Open a file in a tab of its own, or go to its tab if it is open already. The
  # one empty tab with no name that a new pad starts with is used, not left
  # beside it.
  def Void openPath(String p):
    Int open = docWithPath(p)
    if open >= 0:
      switchTo(open)
      remember(p)
    else
      String text = Files.read(p, 64 * 1024 * 1024)
      if text == null and File.exists(p) == 1:
        message = "cannot read ${p}: a directory, or over 64 MB"
      else
        if path.len() > 0 or ed.buf.modified() == 1 or ed.buf.length() > 0:
          newDoc()
        end
        if text == null:
          ed.load("")
          message = "new file"
        else
          ed.load(text)
        end
        path = p
        scrollX = 0
        remember(p)
        ensureTabVisible()
        win.title("pad - ${path}")
      end
    end
    reveal()
  end

  def Void save:
    if path.len() == 0:
      pal.open(Palette.saveMode(), "save as", new List(), new List())
    else
      if Files.save(path, ed.buf.text()) == 1:
        ed.buf.markSaved()
        message = "saved"
      else
        message = "could not save ${path}"
      end
    end
  end

  # With unsaved changes, the first attempt says so and the same action again
  # goes ahead. 1 if it may.
  def Int mayDiscard(String action):
    Int changed = ed.buf.modified()
    if action.equals("quit"):
      changed = anyModified()
    end
    if changed == 0 or was.equals(action):
      return 1
    end
    message = "unsaved changes - Ctrl S saves, or do that again to discard them"
    armed = action
    return 0
  end

  # Save what needs saving, build the file, and show what the compiler said.
  def Void build:
    if path.len() == 0:
      message = "save the file first"
      save()
    else
      if ed.buf.modified() == 1:
        save()
      end
      message = "building..."
      draw()
      Int code = builder.build(path, output)
      if code == 0:
        message = "built ${builder.outputFor(path)}"
      else
        message = "build failed"
      end
      output.show()
      dirty = 1
    end
  end

  # ---- the palette ---------------------------------------------------------------------

  def Void openCommands:
    pal.open(Palette.commandMode(), "command", commandNames, commandHints)
  end

  def Void openFiles:
    List found = Files.list(".", 6, 5000)
    List names = new List()
    Int i = 0
    while i < recents.len():
      names.append(recents.get(i))
      i = i + 1
    end
    i = 0
    while i < found.len():
      String name = found.get(i)
      Int seen = 0
      Int j = 0
      while j < recents.len():
        String r = recents.get(j)
        if r.equals(name):
          seen = 1
        end
        j = j + 1
      end
      if seen == 0:
        names.append(name)
      end
      i = i + 1
    end
    pal.open(Palette.fileMode(), "open", names, new List())
  end

  def Void openFind:
    findOrigin = ed.selStart()
    pal.open(Palette.findMode(), "find", new List(), new List())
    if needle.len() > 0:
      pal.typeText(needle)
      pal.field.selectAll()
    end
  end

  def Void afterFieldEdit:
    if pal.mode == Palette.themeMode():
      previewTheme()
    end
    if pal.mode == Palette.findMode():
      needle = pal.field.buf.text()
      ed.moveTo(findOrigin, 0)
      if needle.len() > 0:
        if ed.find(needle, 1) == 0:
          message = "not found"
        end
      end
      reveal()
    end
  end

  def Void findAgain(Int forward):
    if needle.len() == 0:
      openFind()
    else
      if ed.find(needle, forward) == 0:
        message = "not found"
      end
      reveal()
    end
  end

  def Void acceptPalette(Int shift, Int shortcut):
    Int m = pal.mode
    if m == Palette.commandMode():
      Int which = pal.chosen()
      pal.close()
      if which >= 0:
        String id = commandIds.get(which)
        runCommand(id)
      end
    elif m == Palette.fileMode():
      Int which = pal.chosen()
      String typed = pal.field.buf.text()
      String target = typed
      if which >= 0:
        String named = pal.names.get(which)
        target = named
      end
      if target.len() > 0:
        pal.close()
        openPath(target)
      end
    elif m == Palette.findMode():
      needle = pal.field.buf.text()
      if shift == 1:
        findAgain(0)
      else
        findAgain(1)
      end
    elif m == Palette.replaceMode():
      String replacement = pal.field.buf.text()
      if shortcut == 1:
        message = "replaced ${ed.replaceAll(needle, replacement)}"
        pal.close()
      else
        if ed.replaceNext(needle, replacement) == 0:
          message = "no more"
        end
      end
      reveal()
    elif m == Palette.lineMode():
      Int n = pal.number()
      pal.close()
      if n >= 1:
        ed.goToLine(n)
        reveal()
      end
    elif m == Palette.themeMode():
      if pal.chosen() < 0:
        t = themeBefore
      end
      pal.close()
      rememberTheme()
    elif m == Palette.saveMode():
      String target = pal.field.buf.text()
      pal.close()
      if target.len() > 0:
        path = target
        win.title("pad - ${path}")
        save()
      end
    end
  end

  def Void runCommand(String id):
    if id == "save":
      save()
    elif id == "open":
      openFiles()
    elif id == "new":
      newDoc()
    elif id == "close":
      closeCurrent()
    elif id == "nexttab":
      switchTo((current + 1) % docs.len())
    elif id == "prevtab":
      switchTo((current + docs.len() - 1) % docs.len())
    elif id == "find":
      openFind()
    elif id == "findnext":
      findAgain(1)
    elif id == "findprev":
      findAgain(0)
    elif id == "replace":
      if needle.len() == 0:
        message = "find something first (Ctrl F)"
      else
        pal.open(Palette.replaceMode(), "replace ${needle} with", new List(), new List())
      end
    elif id == "line":
      pal.open(Palette.lineMode(), "go to line", new List(), new List())
    elif id == "build":
      build()
    elif id == "theme":
      t = Themes.pairOf(t)
      rememberTheme()
    elif id == "themes":
      openThemes()
    elif id == "bigger":
      if m.scale < 4:
        m.scale = m.scale + 1
      end
      reveal()
    elif id == "smaller":
      if m.scale > 1:
        m.scale = m.scale - 1
      end
      reveal()
    elif id == "undo":
      ed.undo()
      reveal()
    elif id == "redo":
      ed.redo()
      reveal()
    elif id == "all":
      ed.selectAll()
    elif id == "cut":
      String s = ed.cut()
      if s.len() > 0:
        sdl.setClipboard(s)
      end
      reveal()
    elif id == "copy":
      if ed.hasSelection() == 1:
        sdl.setClipboard(ed.copyText())
      end
    elif id == "paste":
      ed.paste(sdl.clipboard())
      reveal()
    elif id == "quit":
      if mayDiscard("quit") == 1:
        quitting = 1
      end
    end
  end

  # ---- input --------------------------------------------------------------------------------

  def Void onText(String s):
    if pal.isOpen() == 1:
      pal.typeText(s)
      afterFieldEdit()
    else
      ed.typeText(s)
      reveal()
    end
    wake()
  end

  def Void paletteKey(Int key, Int shift, Int shortcut):
    if key == SDL2C.SDLK_ESCAPE():
      closePalette()
    elif key == SDL2C.SDLK_RETURN():
      acceptPalette(shift, shortcut)
    elif key == SDL2C.SDLK_UP():
      pal.up()
      previewTheme()
    elif key == SDL2C.SDLK_DOWN():
      pal.down()
      previewTheme()
    elif key == SDL2C.SDLK_BACKSPACE():
      pal.backspace()
      afterFieldEdit()
    elif key == SDL2C.SDLK_DELETE():
      pal.deleteForward()
      afterFieldEdit()
    elif key == SDL2C.SDLK_LEFT():
      pal.field.left(shift)
    elif key == SDL2C.SDLK_RIGHT():
      pal.field.right(shift)
    elif key == SDL2C.SDLK_HOME():
      pal.field.docStart(shift)
    elif key == SDL2C.SDLK_END():
      pal.field.docEnd(shift)
    elif key == SDL2C.SDLK_F3() and pal.mode == Palette.findMode():
      needle = pal.field.buf.text()
      if shift == 1:
        findAgain(0)
      else
        findAgain(1)
      end
    elif shortcut == 1 and key == 97:
      pal.field.selectAll()
    elif shortcut == 1 and key == 118:
      pal.typeText(sdl.clipboard())
      afterFieldEdit()
    end
  end

  def Void editorKey(Int key, Int shift, Int shortcut, Int alt):
    if shortcut == 1:
      if key == 112:
        openCommands()
      elif key == 111:
        runCommand("open")
      elif key == 110:
        runCommand("new")
      elif key == 119:
        runCommand("close")
      elif key == SDL2C.SDLK_TAB() and shift == 1:
        runCommand("prevtab")
      elif key == SDL2C.SDLK_TAB():
        runCommand("nexttab")
      elif key == 115:
        save()
      elif key == 102:
        runCommand("find")
      elif key == 104:
        runCommand("replace")
      elif key == 108:
        runCommand("line")
      elif key == 116:
        runCommand("theme")
      elif key == 61 or key == 43:
        runCommand("bigger")
      elif key == 45:
        runCommand("smaller")
      elif key == 113:
        runCommand("quit")
      elif key == 97:
        runCommand("all")
      elif key == 99:
        runCommand("copy")
      elif key == 120:
        runCommand("cut")
      elif key == 118:
        runCommand("paste")
      elif key == 122 and shift == 1:
        runCommand("redo")
      elif key == 122:
        runCommand("undo")
      elif key == 121:
        runCommand("redo")
      elif key == SDL2C.SDLK_LEFT():
        ed.wordLeft(shift)
        reveal()
      elif key == SDL2C.SDLK_RIGHT():
        ed.wordRight(shift)
        reveal()
      elif key == SDL2C.SDLK_HOME():
        ed.docStart(shift)
        reveal()
      elif key == SDL2C.SDLK_END():
        ed.docEnd(shift)
        reveal()
      end
    elif key == SDL2C.SDLK_ESCAPE():
      if output.open == 1:
        output.hide()
        reveal()
      end
    elif key == SDL2C.SDLK_F5():
      build()
    elif key == SDL2C.SDLK_F3():
      findAgain(1 - shift)
    elif key == SDL2C.SDLK_LEFT():
      ed.left(shift)
      reveal()
    elif key == SDL2C.SDLK_RIGHT():
      ed.right(shift)
      reveal()
    elif key == SDL2C.SDLK_UP():
      ed.up(shift)
      reveal()
    elif key == SDL2C.SDLK_DOWN():
      ed.down(shift)
      reveal()
    elif key == SDL2C.SDLK_HOME():
      ed.home(shift)
      reveal()
    elif key == SDL2C.SDLK_END():
      ed.endOfLine(shift)
      reveal()
    elif key == SDL2C.SDLK_PAGEUP():
      ed.vertical(0 - m.viewRows(), shift)
      reveal()
    elif key == SDL2C.SDLK_PAGEDOWN():
      ed.vertical(m.viewRows(), shift)
      reveal()
    elif key == SDL2C.SDLK_RETURN():
      ed.newline()
      reveal()
    elif key == SDL2C.SDLK_BACKSPACE():
      ed.backspace()
      reveal()
    elif key == SDL2C.SDLK_DELETE():
      ed.deleteForward()
      reveal()
    elif key == SDL2C.SDLK_TAB():
      if shift == 1:
        ed.untab()
      else
        ed.tab()
      end
      reveal()
    end
  end

  def Void onKey(Int key, Int shift, Int shortcut, Int alt):
    was = armed
    armed = ""
    message = ""
    if pal.isOpen() == 1:
      paletteKey(key, shift, shortcut)
    else
      editorKey(key, shift, shortcut, alt)
    end
    wake()
  end

  def Void onMouseDown(Int x, Int y):
    wake()
    message = ""
    if pal.isOpen() == 1:
      Int w = m.paletteWidth()
      Int left = (m.width - w) / 2
      Int row = y / m.rowHeight() - 2
      if x >= left and x < left + w and row >= 0 and row < pal.results.len():
        pal.selected = row
        acceptPalette(0, 0)
      elif y >= m.rowHeight() * (2 + pal.results.len()) or x < left or x >= left + w:
        closePalette()
      end
    elif y < m.tabsHeight():
      Int tab = tabAt(x)
      if tab >= 0:
        if onTabClose(x, tab) == 1:
          switchTo(tab)
          closeCurrent()
        else
          switchTo(tab)
        end
      end
    elif output.open == 1 and y >= m.tabsHeight() + m.viewHeight() + 1 and y < m.height - m.rowHeight():
      Int i = (y - m.tabsHeight() - m.viewHeight() - 1) / m.rowHeight()
      if i < output.size():
        jumpTo(output.lineAt(i))
      end
    elif y < m.tabsHeight() + m.viewHeight():
      Int row = m.rowAt(y, ed.top)
      Int col = m.colAt(x, ed.buf.lines(), scrollX)
      Int now = sdl.ticks()
      if row == clickedRow and col == clickedCol and now - lastClick < 400:
        ed.placeAt(row, col, 0)
        ed.selectWord(ed.cursor)
        clickedRow = 0 - 1
      else
        ed.placeAt(row, col, 0)
        clickedRow = row
        clickedCol = col
        lastClick = now
        dragging = 1
      end
      reveal()
    end
  end

  def Void onMouseMove(Int x, Int y):
    if dragging == 1:
      ed.placeAt(m.rowAt(y, ed.top), m.colAt(x, ed.buf.lines(), scrollX), 1)
      reveal()
    end
  end

  # Go to the place a line of compiler output names.
  def Void jumpTo(String line):
    Int n = BuildLog.line(line)
    if n < 1:
      message = "that line names no place"
    else
      String file = BuildLog.file(line)
      String mine = path
      Int slash = 0 - 1
      Int i = 0
      while i < mine.len():
        if mine.at(i) == 47:
          slash = i
        end
        i = i + 1
      end
      mine = mine.substr(slash + 1, mine.len())
      if file.len() > 0 and file.equals(mine) == 0 and file.equals(path) == 0:
        message = "that is in ${file}"
      else
        ed.goToLine(n)
        Int c = BuildLog.column(line)
        if c > 1:
          ed.placeAt(n - 1, c - 1, 0)
        end
        reveal()
      end
    end
  end

  def Void handle:
    if sdl.isQuit() == 1:
      was = armed
      armed = ""
      runCommand("quit")
    elif sdl.isResize() == 1:
      m.width = win.width()
      m.height = win.height()
      reveal()
    elif sdl.isKeyDown() == 1:
      onKey(sdl.key(), sdl.shift(), sdl.shortcut(), sdl.alt())
    elif sdl.isText() == 1:
      onText(sdl.text())
    elif sdl.isMouseDown() == 1:
      if sdl.mouseButton() == 1:
        onMouseDown(sdl.mouseX(), sdl.mouseY())
      end
    elif sdl.isMouseUp() == 1:
      dragging = 0
    elif sdl.isMouseMove() == 1:
      onMouseMove(sdl.mouseX(), sdl.mouseY())
    elif sdl.isWheel() == 1:
      ed.scrollBy(0 - sdl.wheel() * 3)
      dirty = 1
    end
  end

  # ---- the loop -------------------------------------------------------------------------------

  # Wait for something to happen: an event, or the caret's next change.
  # Nothing is drawn, and no time is used, while nothing does.
  def Void run:
    sdl.startText()
    lastBlink = sdl.ticks()
    draw()
    while quitting == 0:
      Int now = sdl.ticks()
      Int wait = 500 - (now - lastBlink)
      if wait < 1:
        wait = 1
      end
      Int got = sdl.wait(wait)
      while got == 1 and quitting == 0:
        handle()
        got = sdl.poll()
      end
      now = sdl.ticks()
      if now - lastBlink >= 500:
        lastBlink = now
        if caretOn == 1:
          caretOn = 0
        else
          caretOn = 1
        end
        dirty = 1
      end
      if dirty == 1:
        draw()
      end
    end
  end
end

class Main from IO
  def main:
    Sdl sdl = new Sdl()
    Window win = new Window(sdl, "pad", 960, 640)
    win.resizable()
    Renderer view = new Renderer(win)
    Pad pad = new Pad(sdl, win, view)
    String script = ""
    String shot = ""
    Int frames = 1
    String first = ""
    Int i = 1
    while i < args():
      String a = arg(i)
      if a == "--catmintc":
        i = i + 1
        pad.builder.compiler = arg(i)
      elif a == "--themes":
        i = i + 1
        pad.themeDir = arg(i)
      elif a == "-I":
        i = i + 1
        pad.builder.includes.append(arg(i))
      elif a == "--play":
        i = i + 1
        script = arg(i)
      elif a == "--frames":
        i = i + 1
        String n = arg(i)
        frames = n.toInt()
      elif a == "--shot":
        i = i + 1
        shot = arg(i)
      else
        first = a
      end
      i = i + 1
    end
    pad.restoreTheme()
    if pad.builder.compiler.len() == 0:
      pad.builder.locate(arg(0))
    end
    if first.len() > 0:
      pad.openPath(first)
      pad.message = ""
    end
    if script.len() > 0:
      PlayScript runner = new PlayScript(pad)
      runner.play(script, frames, shot)
    else
      pad.run()
    end
  end
end
