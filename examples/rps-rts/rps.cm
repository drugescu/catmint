# RPS iso-RTS, built up in milestones. A catmint port of a rock-paper-
# scissors isometric RTS prototype, over SDL2.
#
#   milestone 1 -- a window that opens, clears, and closes cleanly: proves
#                  the FFI path (`extern class`, `unsafe`, `link`, `Ptr`,
#                  `finalize`) against a real C library end to end.
#   milestone 2 -- the static iso grid: camera/projection math and the
#                  tinted-checkerboard board.
#   milestone 3 -- units and bases drawn as flat-shaded solids (rock = cube,
#                  paper = slab, scissors = pyramid), painter-sorted, with
#                  health bars. Placed by hand: nothing moves yet.
#   milestone 4 -- the simulation: units hunt, close in, hit for 3x or 1/3 by
#                  rock-paper-scissors, die and are cleaned up. `rps --frames
#                  N` runs N fixed 1/60 s steps before drawing, so a battle
#                  can be checked without watching it.
#
# The SDL binding is sdl.cmm; its C side is sdl_shim.c, built by build.sh.

using sdl

# Iso projection: world tile coordinates (x, y, and an optional height z, all
# in tile units) to screen pixels. tw/th are one tile's on-screen size once
# the whole cols x rows grid is scaled to fit the window; camX/camY centre
# it. This is resize()/toScreen() from the shared prototype, computed once
# rather than on every resize since the window does not yet track resizing.
class Camera from Object
  Int cols
  Int rows
  Float tw
  Float th
  Float camX
  Float camY

  constructor(Int c, Int r, Float tileW, Float tileH, Float windowW, Float windowH):
    cols = c
    rows = r
    Float span = (c + r) / 2.0
    Float sx = (windowW - 24.0) / (span * tileW)
    Float sy = (windowH - 170.0) / (span * tileH)
    Float s = sx
    if sy < sx:
      s = sy
    end
    tw = tileW * s
    th = tileH * s
    camX = windowW / 2.0 - (c - r) * tw / 4.0
    camY = windowH * 0.47 - span * th / 2.0
  end

  def Float screenX(Float x, Float y):
    return (x - y) * tw / 2.0 + camX
  end

  def Float screenY(Float x, Float y, Float z):
    return (x + y) * th / 2.0 + camY - z * th
  end
end

# Everything that draws the game world: the board, the solids units are made
# of, the health bars. It holds the renderer and the camera so an entity's
# draw() takes one argument, and the team palette so shading is looked up
# rather than computed.
#
# A palette entry is team * 3 + level, level 0 being the face turned away
# from the light, 1 the other side face, 2 the top. The values are the
# prototype's hsl(38|275, 65%, 34|48|64%) worked out once; catmint has no HSL
# and this is a port of the look, not of the colour arithmetic.
class Gfx from Object
  Renderer view = null
  Camera cam = null
  Int white = 0
  Ints pr
  Ints pg
  Ints pb

  constructor(Renderer v, Camera c):
    view = v
    cam = c
    pr = new Ints(6)
    pg = new Ints(6)
    pb = new Ints(6)
    tone(0, 143, 102, 30)
    tone(1, 202, 144, 43)
    tone(2, 223, 179, 104)
    tone(3, 96, 30, 143)
    tone(4, 136, 43, 202)
    tone(5, 173, 104, 223)
  end

  def Void tone(Int i, Int r, Int g, Int b):
    pr.set(i, r)
    pg.set(i, g)
    pb.set(i, b)
  end

  # An entity that has just been hit is drawn all white for a moment, as in
  # the prototype: set white before drawing it, clear it after.
  def Void shade(Int team, Int level):
    if white == 1:
      view.setColor(255, 255, 255)
    else
      Int i = team * 3 + level
      view.setColor(pr.get(i), pg.get(i), pb.get(i))
    end
  end

  # The checkerboard plus tinted home zones from the prototype's drawGrid():
  # x < 3 is the player's zone, x >= cols - 3 the enemy's, everything between
  # alternates by (x + y) parity. Plain RGB constants, as above.
  def Void grid:
    Int cols = cam.cols
    Int rows = cam.rows
    Int y = 0
    while y < rows:
      Int x = 0
      while x < cols:
        Int home = 0 - 1
        if x < 3:
          home = 0
        end
        if x >= cols - 3:
          home = 1
        end

        Int r = 44
        Int g = 53
        Int b = 64
        if home == 0:
          r = 58
          g = 50
          b = 38
        elif home == 1:
          r = 46
          g = 38
          b = 58
        elif (x + y) % 2 == 0:
          r = 48
          g = 58
          b = 70
        end

        Float fx = x
        Float fy = y
        Float sx0 = cam.screenX(fx, fy)
        Float sy0 = cam.screenY(fx, fy, 0.0)
        Float sx1 = cam.screenX(fx + 1.0, fy)
        Float sy1 = cam.screenY(fx + 1.0, fy, 0.0)
        Float sx2 = cam.screenX(fx + 1.0, fy + 1.0)
        Float sy2 = cam.screenY(fx + 1.0, fy + 1.0, 0.0)
        Float sx3 = cam.screenX(fx, fy + 1.0)
        Float sy3 = cam.screenY(fx, fy + 1.0, 0.0)

        view.setColor(r, g, b)
        view.fillQuad(sx0, sy0, sx1, sy1, sx2, sy2, sx3, sy3)
        view.setColor(35, 42, 51)
        view.line(sx0, sy0, sx1, sy1)
        view.line(sx1, sy1, sx2, sy2)
        view.line(sx2, sy2, sx3, sy3)
        view.line(sx3, sy3, sx0, sy0)

        x = x + 1
      end
      y = y + 1
    end
  end

  # One flat-shaded face with a dark outline. Four corners in order; a
  # triangle repeats its last.
  def Void face(Float x0, Float y0, Float x1, Float y1, Float x2, Float y2, Float x3, Float y3, Int team, Int level):
    shade(team, level)
    view.fillQuad(x0, y0, x1, y1, x2, y2, x3, y3)
    view.setColor(25, 28, 34)
    view.line(x0, y0, x1, y1)
    view.line(x1, y1, x2, y2)
    view.line(x2, y2, x3, y3)
    view.line(x3, y3, x0, y0)
  end

  # A box centred on tile (ex, ey), h is its half-width in tiles, z its
  # height in tiles. Only the three faces an iso camera sees are drawn. Each
  # corner's screen x does not depend on height, so the top corners are the
  # bottom ones lifted by z * th.
  def Void prism(Float ex, Float ey, Float h, Float z, Int team):
    Float lift = z * cam.th
    Float xpp = cam.screenX(ex + h, ey + h)
    Float ypp = cam.screenY(ex + h, ey + h, 0.0)
    Float xpm = cam.screenX(ex + h, ey - h)
    Float ypm = cam.screenY(ex + h, ey - h, 0.0)
    Float xmp = cam.screenX(ex - h, ey + h)
    Float ymp = cam.screenY(ex - h, ey + h, 0.0)
    Float xmm = cam.screenX(ex - h, ey - h)
    Float ymm = cam.screenY(ex - h, ey - h, 0.0)
    face(xpm, ypm - lift, xpp, ypp - lift, xpp, ypp, xpm, ypm, team, 1)
    face(xmp, ymp - lift, xpp, ypp - lift, xpp, ypp, xmp, ymp, team, 0)
    face(xmm, ymm - lift, xpm, ypm - lift, xpp, ypp - lift, xmp, ymp - lift, team, 2)
  end

  def Void pyramid(Float ex, Float ey, Float h, Float z, Int team):
    Float ax = cam.screenX(ex, ey)
    Float ay = cam.screenY(ex, ey, z)
    Float xpm = cam.screenX(ex + h, ey - h)
    Float ypm = cam.screenY(ex + h, ey - h, 0.0)
    Float xpp = cam.screenX(ex + h, ey + h)
    Float ypp = cam.screenY(ex + h, ey + h, 0.0)
    Float xmp = cam.screenX(ex - h, ey + h)
    Float ymp = cam.screenY(ex - h, ey + h, 0.0)
    face(ax, ay, xpm, ypm, xpp, ypp, xpp, ypp, team, 1)
    face(ax, ay, xmp, ymp, xpp, ypp, xpp, ypp, team, 0)
  end

  # Green above half health, amber above a quarter, red below. The prototype
  # backs the bar with 55% black; SDL alpha blending is a mode of its own,
  # so this uses a solid near-black instead.
  def Void hpBar(Float ex, Float ey, Float z, Float hp, Float maxHp):
    Float sx = cam.screenX(ex, ey)
    Float sy = cam.screenY(ex, ey, z)
    Float w = cam.tw * 0.42
    Float ratio = hp / maxHp
    if ratio < 0.0:
      ratio = 0.0
    end
    view.setColor(12, 14, 18)
    view.fillRect(sx - w / 2.0 - 1.0, sy - 4.0, w + 2.0, 4.0)
    if ratio > 0.5:
      view.setColor(123, 211, 137)
    elif ratio > 0.25:
      view.setColor(242, 179, 61)
    else
      view.setColor(230, 86, 79)
    end
    view.fillRect(sx - w / 2.0, sy - 3.0, w * ratio, 2.0)
  end
end

# Something with a place on the board that can be drawn. depth() is the key
# the painter's sort orders by: further from the camera first, and on an iso
# board that is simply smaller x + y.
interface Drawable
  def Float depth
  def Void draw(Gfx g)
end

# What units and bases have in common: a place, a side, health. team: 0 the
# player, 1 the enemy. flash counts down from the moment of a hit.
class Entity does Drawable
  Int team
  Int isBase
  Float x
  Float y
  Float hp
  Float maxHp
  Float flash

  def Float depth:
    return x + y
  end

  def Int alive:
    if hp > 0.0:
      return 1
    end
    return 0
  end

  # Subclasses draw themselves; an Entity alone is nothing to look at.
  def Void draw(Gfx g):
  end
end

# kind: 0 rock, 1 paper, 2 scissors. A unit hunts the nearest enemy it can
# see, walks until it is within reach, and hits on a cooldown. Speed, reach,
# damage and cadence are the prototype's own numbers.
class Unit from Entity
  Int kind
  Float cd
  Entity target = null

  constructor(Int t, Int k, Float px, Float py):
    team = t
    kind = k
    x = px
    y = py
    maxHp = 40.0
    hp = maxHp
  end

  def Void update(World w, Float dt):
    cd = cd - dt
    if cd < 0.0:
      cd = 0.0
    end
    flash = flash - dt
    if flash < 0.0:
      flash = 0.0
    end

    if target != null and target.alive() == 0:
      target = null
    end

    # The enemy always hunts; the player's units only wake when something is
    # within 2.2 tiles, because until they are given orders they hold ground.
    if target == null:
      Float sight = 2.2
      if team == 1:
        sight = 1000000000.0
      end
      target = w.nearestEnemy(self, sight)
    end

    if target != null:
      Float dx = target.x - x
      Float dy = target.y - y
      Float d = Math.sqrt(dx * dx + dy * dy)
      if d > 0.85:
        Float step = 1.7 * dt
        if step > d - 0.85:
          step = d - 0.85
        end
        x = x + dx / d * step
        y = y + dy / d * step
      elif cd == 0.0:
        w.hit(self, target)
        cd = 0.5
      end
    end
  end

  def Void draw(Gfx g):
    g.white = 0
    if flash > 0.0:
      g.white = 1
    end
    if kind == 0:
      g.prism(x, y, 0.22, 0.55, team)
    elif kind == 1:
      g.prism(x, y, 0.30, 0.12, team)
    else
      g.pyramid(x, y, 0.26, 0.85, team)
    end
    g.white = 0
    g.hpBar(x, y, 0.95, hp, maxHp)
  end
end

# A plinth with a tower on it. It does not fight; losing it loses the game.
class Base from Entity
  constructor(Int t, Float px, Float py):
    team = t
    isBase = 1
    x = px
    y = py
    maxHp = 150.0
    hp = maxHp
  end

  def Void draw(Gfx g):
    g.white = 0
    if flash > 0.0:
      g.white = 1
    end
    g.prism(x, y, 0.55, 0.3, team)
    g.prism(x, y, 0.28, 1.0, team)
    g.white = 0
    g.hpBar(x, y, 1.3, hp, maxHp)
  end
end

# The battlefield and its rules. `things` is in creation order and that order
# is the simulation's: separation and targeting walk it, so it must not depend
# on how the frame is drawn. The painter's sort therefore works on `order`, a
# second list of the same entities.
class World from Object
  List things
  List order
  Entity playerBase = null
  Entity enemyBase = null
  Int cols = 14
  Int rows = 10
  # 0 running, 1 the player won, 2 the player lost.
  Int over = 0

  def Void setup:
    things.append(new Unit(0, 0, 3.2, 3.0))
    things.append(new Unit(0, 1, 3.4, 4.5))
    things.append(new Unit(0, 2, 3.2, 6.0))
    things.append(new Unit(0, 0, 2.6, 5.2))
    things.append(new Unit(1, 2, 10.8, 3.2))
    things.append(new Unit(1, 0, 10.6, 4.6))
    things.append(new Unit(1, 1, 10.8, 6.1))
    things.append(new Unit(1, 1, 11.4, 5.0))
    playerBase = new Base(0, 1.5, 4.5)
    enemyBase = new Base(1, 12.5, 4.5)
    things.append(playerBase)
    things.append(enemyBase)
    rebuildOrder()
  end

  def Void rebuildOrder:
    order = things.slice(0, things.len())
  end

  # 1 when a beats b: rock breaks scissors, scissors cut paper, paper covers
  # rock. With rock 0, paper 1, scissors 2, a beats (a + 2) mod 3.
  def Int beats(Int a, Int b):
    if (a + 2) % 3 == b:
      return 1
    end
    return 0
  end

  def Void hit(Entity a, Entity b):
    Float m = 1.0
    if b.isBase == 0:
      Unit ua = a
      Unit ub = b
      if beats(ua.kind, ub.kind) == 1:
        m = 3.0
      elif beats(ub.kind, ua.kind) == 1:
        m = 1.0 / 3.0
      end
    end
    b.hp = b.hp - 8.0 * m
    b.flash = 0.12
  end

  # The closest living enemy of u within maxD tiles, or null. Real distances,
  # not squares: two enemies almost equally far can round to the same square
  # root, and the prototype then keeps the first it found where comparing
  # squares picks the other. Which of two is "closest" decides who a unit
  # fights, so the tie has to break the way the prototype's does.
  def Entity nearestEnemy(Entity u, Float maxD):
    Entity best = null
    Float bd = maxD
    for item in things:
      Entity e = item
      if e.team != u.team and e.alive() == 1:
        Float dx = e.x - u.x
        Float dy = e.y - u.y
        Float d = Math.sqrt(dx * dx + dy * dy)
        if d < bd:
          bd = d
          best = e
        end
      end
    end
    return best
  end

  # No pathfinding: units that overlap are pushed apart.
  def Void separate:
    Int n = things.len()
    Int i = 0
    while i < n:
      Entity a = things.get(i)
      if a.isBase == 0:
        Int j = i + 1
        while j < n:
          Entity b = things.get(j)
          if b.isBase == 0:
            Float dx = b.x - a.x
            Float dy = b.y - a.y
            Float d = Math.sqrt(dx * dx + dy * dy)
            if d == 0.0:
              d = 0.001
            end
            if d < 0.45:
              Float p = (0.45 - d) / 2.0
              Float nx = dx / d * p
              Float ny = dy / d * p
              a.x = a.x - nx
              a.y = a.y - ny
              b.x = b.x + nx
              b.y = b.y + ny
            end
          end
          j = j + 1
        end
      end
      i = i + 1
    end
  end

  def Float clampTo(Float v, Float lo, Float hi):
    if v < lo:
      return lo
    end
    if v > hi:
      return hi
    end
    return v
  end

  # Drop the dead. A dying unit lets go of its target on the way out: two
  # units that killed each other in one step would otherwise hold each other
  # alive for ever, and reference counting cannot see a cycle.
  def Void clearDead:
    Int dead = 0
    for item in things:
      Entity e = item
      if e.alive() == 0 and e.isBase == 0:
        dead = dead + 1
      end
    end
    if dead > 0:
      List keep
      for item in things:
        Entity e = item
        if e.alive() == 1 or e.isBase == 1:
          keep.append(e)
        else
          Unit gone = e
          gone.target = null
        end
      end
      things = keep
      rebuildOrder()
    end
  end

  def Void update(Float dt):
    if over == 0:
      for item in things:
        Entity e = item
        e.flash = e.flash - dt
        if e.flash < 0.0:
          e.flash = 0.0
        end
        if e.isBase == 0:
          Unit u = e
          u.update(self, dt)
        end
      end

      separate()
      for item in things:
        Entity e = item
        if e.isBase == 0:
          e.x = clampTo(e.x, 0.3, cols - 0.3)
          e.y = clampTo(e.y, 0.3, rows - 0.3)
        end
      end

      clearDead()

      if enemyBase.alive() == 0:
        over = 1
      elif playerBase.alive() == 0:
        over = 2
      end
    end
  end

  # Insertion sort of `order` on depth. It is nearly in order from one frame
  # to the next, which is the case insertion sort is quickest at.
  def Void sortForDrawing:
    Int i = 1
    while i < order.len():
      Drawable key = order.get(i)
      Float kd = key.depth()
      Int j = i - 1
      Int moving = 1
      while j >= 0 and moving == 1:
        Drawable other = order.get(j)
        if other.depth() > kd:
          order.set(j + 1, other)
          j = j - 1
        else
          moving = 0
        end
      end
      order.set(j + 1, key)
      i = i + 1
    end
  end

  def Void draw(Gfx g):
    sortForDrawing()
    for item in order:
      Drawable d = item
      d.draw(g)
    end
  end

  # Every unit's state, one per line, in simulation order: what a second
  # implementation of the rules is compared against. Positions and health are
  # printed as fixed-point integers (x 10^12, hp 10^9) because a float prints
  # with six digits, which hides the last-bit differences this exists to find.
  def String dump:
    String s = ""
    for item in things:
      Entity e = item
      if e.isBase == 0:
        Unit u = e
        Int64 fx = u.x * 1000000000000.0
        Int64 fy = u.y * 1000000000000.0
        Int64 fh = u.hp * 1000000000.0
        s = s + "${u.team} ${u.kind} ${fx} ${fy} ${fh}\n"
      end
    end
    return s
  end

  # One line: who is left of each kind, and the bases.
  def String summary:
    Int p0 = 0
    Int p1 = 0
    Int p2 = 0
    Int e0 = 0
    Int e1 = 0
    Int e2 = 0
    for item in things:
      Entity e = item
      if e.isBase == 0:
        Unit u = e
        if u.team == 0 and u.kind == 0:
          p0 = p0 + 1
        elif u.team == 0 and u.kind == 1:
          p1 = p1 + 1
        elif u.team == 0 and u.kind == 2:
          p2 = p2 + 1
        elif u.kind == 0:
          e0 = e0 + 1
        elif u.kind == 1:
          e1 = e1 + 1
        else
          e2 = e2 + 1
        end
      end
    end
    return "player R${p0} P${p1} S${p2}  enemy R${e0} P${e1} S${e2}  bases ${playerBase.hp} ${enemyBase.hp}  over ${over}"
  end
end

class Main from IO
  def main:
    Sdl sdl = new Sdl()
    Int windowW = 960
    Int windowH = 640
    Window win = new Window(sdl, "catmint RPS RTS", windowW, windowH)
    Renderer view = new Renderer(win)
    Float fw = windowW
    Float fh = windowH
    Camera cam = new Camera(14, 10, 64.0, 32.0, fw, fh)
    Gfx gfx = new Gfx(view, cam)
    World world = new World()
    world.setup()

    # `--frames N` runs N fixed steps before the first frame is drawn, and
    # `--shot out.bmp` then draws one frame, saves it and exits. Together they
    # make a run reproducible: the same battle every time, no window watching.
    Int frames = 0
    Int dump = 0
    String shot = ""
    Int a = 1
    while a < args():
      if arg(a) == "--frames":
        frames = arg(a + 1).toInt()
        a = a + 1
      elif arg(a) == "--shot":
        shot = arg(a + 1)
        a = a + 1
      elif arg(a) == "--dump":
        dump = 1
      end
      a = a + 1
    end
    Int before = allocated()
    Int step = 0
    while step < frames:
      world.update(1.0 / 60.0)
      step = step + 1
    end
    if frames > 0:
      out("after ${frames}: ${world.summary()}  objects +${allocated() - before}\n")
      if dump == 1:
        out(world.dump())
      end
    end

    Int running = 1
    Int escape = 27
    Int last = sdl.ticks()
    while running == 1:
      while sdl.poll() == 1:
        if sdl.isQuit() == 1:
          running = 0
        end
        if sdl.isKeyDown() == 1 and sdl.key() == escape:
          running = 0
        end
      end

      Int now = sdl.ticks()
      Float dt = (now - last) / 1000.0
      last = now
      if dt > 0.05:
        dt = 0.05
      end
      if shot.len() == 0:
        world.update(dt)
      end

      view.clear(35, 42, 51)
      gfx.grid()
      world.draw(gfx)
      if shot.len() > 0:
        view.saveBMP(shot)
        running = 0
      end
      view.present()
      sdl.delay(16)
    end

    out("closed cleanly\n")
  end
end
