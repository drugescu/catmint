# RPS iso-RTS, built up in milestones. A catmint port of a rock-paper-
# scissors isometric RTS prototype, over SDL2.
#
#   milestone 1 -- a window that opens, clears, and closes cleanly: proves
#                  the FFI path (`extern class`, `unsafe`, `link`, `Ptr`,
#                  `finalize`) against a real C library end to end.
#   milestone 2 -- the static iso grid: camera/projection math and the
#                  tinted-checkerboard board.
#   milestone 3 -- units and bases drawn as flat-shaded solids (rock = cube,
#                  paper = slab, scissors = pyramid), painter-sorted, with
#                  health bars.
#   milestone 4 -- the simulation: units hunt, close in, hit for 3x or 1/3 by
#                  rock-paper-scissors, die and are cleaned up.
#   milestone 5 -- the player's hand on it: gold and spawning, selection by
#                  click and by dragging a box, move and attack orders, and
#                  the effects that answer them.
#
# Controls: 1 2 3 or the buttons spawn rock, paper, scissors for 30 gold.
# Click a unit of yours to select it, drag a box to select several, A selects
# all, Esc clears. With units selected, click the ground to move there or an
# enemy to attack it; right-click always orders. Q or closing the window
# quits.
#
# Runs can be scripted and checked without a screen:
#   --frames N     run N fixed 1/60 s steps, print a summary, then draw
#   --dump         with --frames: every unit's exact state, for check.sh
#   --play FILE    feed FILE's input to the steps (see tests/*.play)
#   --shot F.bmp   save the first frame drawn and exit
#
# SDL comes from the standard library: lib/sdl.cmm, over lib/sdl2.cmm, which
# tools/bindgen.py generates from SDL's headers. No C is compiled.

using sdl
using random

# Iso projection: world tile coordinates (x, y, and an optional height z, all
# in tile units) to screen pixels. tw/th are one tile's on-screen size once
# the whole cols x rows grid is scaled to fit the window; camX/camY centre
# it. This is resize()/toScreen() from the shared prototype, computed once
# rather than on every resize since the window does not yet track resizing.
class Camera from Object
  Int cols
  Int rows
  Float tw
  Float th
  Float camX
  Float camY

  constructor(Int c, Int r, Float tileW, Float tileH, Float windowW, Float windowH):
    cols = c
    rows = r
    Float span = (c + r) / 2.0
    Float sx = (windowW - 24.0) / (span * tileW)
    Float sy = (windowH - 170.0) / (span * tileH)
    Float s = sx
    if sy < sx:
      s = sy
    end
    tw = tileW * s
    th = tileH * s
    camX = windowW / 2.0 - (c - r) * tw / 4.0
    camY = windowH * 0.47 - span * th / 2.0
  end

  def Float screenX(Float x, Float y):
    return (x - y) * tw / 2.0 + camX
  end

  def Float screenY(Float x, Float y, Float z):
    return (x + y) * th / 2.0 + camY - z * th
  end

  # The inverse at ground level: which tile point is under screen pixel
  # (sx, sy). The prototype's toWorld().
  def Float worldX(Float sx, Float sy):
    Float a = (sx - camX) / (tw / 2.0)
    Float b = (sy - camY) / (th / 2.0)
    return (a + b) / 2.0
  end

  def Float worldY(Float sx, Float sy):
    Float a = (sx - camX) / (tw / 2.0)
    Float b = (sy - camY) / (th / 2.0)
    return (b - a) / 2.0
  end
end

# Everything that draws the game world: the board, the solids units are made
# of, health bars, rings, and a small digit font for the HUD. It holds the
# renderer and the camera so an entity's draw() takes one argument, and the
# team palette so shading is looked up rather than computed.
#
# A palette entry is team * 3 + level, level 0 being the face turned away
# from the light, 1 the other side face, 2 the top. The values are the
# prototype's hsl(38|275, 65%, 34|48|64%) worked out once; catmint has no HSL
# and this is a port of the look, not of the colour arithmetic.
class Gfx from Object
  Renderer view = null
  Camera cam = null
  Int white = 0
  Int dim = 0
  Ints pr = null
  Ints pg = null
  Ints pb = null
  Ints glyphs = null

  constructor(Renderer v, Camera c):
    view = v
    cam = c
    pr = new Ints(6)
    pg = new Ints(6)
    pb = new Ints(6)
    tone(0, 143, 102, 30)
    tone(1, 202, 144, 43)
    tone(2, 223, 179, 104)
    tone(3, 96, 30, 143)
    tone(4, 136, 43, 202)
    tone(5, 173, 104, 223)

    # A 3x5 font for 0-9, one Int a digit: fifteen bits, row by row from the
    # top, the leftmost pixel of a row the highest bit.
    glyphs = new Ints(10)
    glyphs.set(0, 31599)
    glyphs.set(1, 11415)
    glyphs.set(2, 29671)
    glyphs.set(3, 29647)
    glyphs.set(4, 23497)
    glyphs.set(5, 31183)
    glyphs.set(6, 31215)
    glyphs.set(7, 29257)
    glyphs.set(8, 31727)
    glyphs.set(9, 31695)
  end

  def Void tone(Int i, Int r, Int g, Int b):
    pr.set(i, r)
    pg.set(i, g)
    pb.set(i, b)
  end

  # An entity that has just been hit is drawn all white for a moment, as in
  # the prototype; a spawn button the player cannot afford is drawn in grey.
  # Both are flags set around a draw rather than arguments to every face.
  def Void shade(Int team, Int level):
    if white == 1:
      view.setColor(255, 255, 255)
    elif dim == 1:
      Int grey = 70 + level * 15
      view.setColor(grey, grey + 4, grey + 10)
    else
      Int i = team * 3 + level
      view.setColor(pr.get(i), pg.get(i), pb.get(i))
    end
  end

  # The checkerboard plus tinted home zones from the prototype's drawGrid():
  # x < 3 is the player's zone, x >= cols - 3 the enemy's, everything between
  # alternates by (x + y) parity. Plain RGB constants, as above.
  def Void grid:
    Int cols = cam.cols
    Int rows = cam.rows
    Int y = 0
    while y < rows:
      Int x = 0
      while x < cols:
        Int home = 0 - 1
        if x < 3:
          home = 0
        end
        if x >= cols - 3:
          home = 1
        end

        Int r = 44
        Int g = 53
        Int b = 64
        if home == 0:
          r = 58
          g = 50
          b = 38
        elif home == 1:
          r = 46
          g = 38
          b = 58
        elif (x + y) % 2 == 0:
          r = 48
          g = 58
          b = 70
        end

        Float fx = x
        Float fy = y
        Float sx0 = cam.screenX(fx, fy)
        Float sy0 = cam.screenY(fx, fy, 0.0)
        Float sx1 = cam.screenX(fx + 1.0, fy)
        Float sy1 = cam.screenY(fx + 1.0, fy, 0.0)
        Float sx2 = cam.screenX(fx + 1.0, fy + 1.0)
        Float sy2 = cam.screenY(fx + 1.0, fy + 1.0, 0.0)
        Float sx3 = cam.screenX(fx, fy + 1.0)
        Float sy3 = cam.screenY(fx, fy + 1.0, 0.0)

        view.setColor(r, g, b)
        view.fillQuad(sx0, sy0, sx1, sy1, sx2, sy2, sx3, sy3)
        view.setColor(35, 42, 51)
        view.line(sx0, sy0, sx1, sy1)
        view.line(sx1, sy1, sx2, sy2)
        view.line(sx2, sy2, sx3, sy3)
        view.line(sx3, sy3, sx0, sy0)

        x = x + 1
      end
      y = y + 1
    end
  end

  # One flat-shaded face with a dark outline. Four corners in order; a
  # triangle repeats its last.
  def Void face(Float x0, Float y0, Float x1, Float y1, Float x2, Float y2, Float x3, Float y3, Int team, Int level):
    shade(team, level)
    view.fillQuad(x0, y0, x1, y1, x2, y2, x3, y3)
    view.setColor(25, 28, 34)
    view.line(x0, y0, x1, y1)
    view.line(x1, y1, x2, y2)
    view.line(x2, y2, x3, y3)
    view.line(x3, y3, x0, y0)
  end

  # A box centred on tile (ex, ey), h is its half-width in tiles, z its
  # height in tiles. Only the three faces an iso camera sees are drawn. Each
  # corner's screen x does not depend on height, so the top corners are the
  # bottom ones lifted by z * th.
  def Void prism(Float ex, Float ey, Float h, Float z, Int team):
    Float lift = z * cam.th
    Float xpp = cam.screenX(ex + h, ey + h)
    Float ypp = cam.screenY(ex + h, ey + h, 0.0)
    Float xpm = cam.screenX(ex + h, ey - h)
    Float ypm = cam.screenY(ex + h, ey - h, 0.0)
    Float xmp = cam.screenX(ex - h, ey + h)
    Float ymp = cam.screenY(ex - h, ey + h, 0.0)
    Float xmm = cam.screenX(ex - h, ey - h)
    Float ymm = cam.screenY(ex - h, ey - h, 0.0)
    face(xpm, ypm - lift, xpp, ypp - lift, xpp, ypp, xpm, ypm, team, 1)
    face(xmp, ymp - lift, xpp, ypp - lift, xpp, ypp, xmp, ymp, team, 0)
    face(xmm, ymm - lift, xpm, ypm - lift, xpp, ypp - lift, xmp, ymp - lift, team, 2)
  end

  def Void pyramid(Float ex, Float ey, Float h, Float z, Int team):
    Float ax = cam.screenX(ex, ey)
    Float ay = cam.screenY(ex, ey, z)
    Float xpm = cam.screenX(ex + h, ey - h)
    Float ypm = cam.screenY(ex + h, ey - h, 0.0)
    Float xpp = cam.screenX(ex + h, ey + h)
    Float ypp = cam.screenY(ex + h, ey + h, 0.0)
    Float xmp = cam.screenX(ex - h, ey + h)
    Float ymp = cam.screenY(ex - h, ey + h, 0.0)
    face(ax, ay, xpm, ypm, xpp, ypp, xpp, ypp, team, 1)
    face(ax, ay, xmp, ymp, xpp, ypp, xpp, ypp, team, 0)
  end

  # kind 0 rock, 1 paper, 2 scissors, standing on tile point (ex, ey).
  def Void figure(Int kind, Float ex, Float ey, Int team):
    if kind == 0:
      prism(ex, ey, 0.22, 0.55, team)
    elif kind == 1:
      prism(ex, ey, 0.30, 0.12, team)
    else
      pyramid(ex, ey, 0.26, 0.85, team)
    end
  end

  # Green above half health, amber above a quarter, red below, on the
  # prototype's 55% black.
  def Void hpBar(Float ex, Float ey, Float z, Float hp, Float maxHp):
    Float sx = cam.screenX(ex, ey)
    Float sy = cam.screenY(ex, ey, z)
    Float w = cam.tw * 0.42
    Float ratio = hp / maxHp
    if ratio < 0.0:
      ratio = 0.0
    end
    view.setColorA(0, 0, 0, 140)
    view.fillRect(sx - w / 2.0 - 1.0, sy - 4.0, w + 2.0, 4.0)
    if ratio > 0.5:
      view.setColor(123, 211, 137)
    elif ratio > 0.25:
      view.setColor(242, 179, 61)
    else
      view.setColor(230, 86, 79)
    end
    view.fillRect(sx - w / 2.0, sy - 3.0, w * ratio, 2.0)
  end

  # An ellipse lying on the ground around tile point (ex, ey), radii rx and
  # ry in tiles -- the shape of every ring the prototype draws.
  def Void ring(Float ex, Float ey, Float rx, Float ry, Int r, Int g, Int b, Int a):
    Float cx = cam.screenX(ex, ey)
    Float cy = cam.screenY(ex, ey, 0.0)
    Float ax = cam.tw * rx
    Float ay = cam.th * ry
    view.setColorA(r, g, b, a)
    Float px = cx + ax
    Float py = cy
    Int i = 1
    while i <= 32:
      Float t = i * Math.pi() / 16.0
      Float qx = cx + ax * Math.cos(t)
      Float qy = cy + ay * Math.sin(t)
      view.line(px, py, qx, qy)
      px = qx
      py = qy
      i = i + 1
    end
  end

  # A dashed straight line, four pixels on and three off.
  def Void dashed(Float x0, Float y0, Float x1, Float y1):
    Float dx = x1 - x0
    Float dy = y1 - y0
    Float len = Math.sqrt(dx * dx + dy * dy)
    if len > 0.0:
      Float ux = dx / len
      Float uy = dy / len
      Float at = 0.0
      while at < len:
        Float stop = at + 4.0
        if stop > len:
          stop = len
        end
        view.line(x0 + ux * at, y0 + uy * at, x0 + ux * stop, y0 + uy * stop)
        at = at + 7.0
      end
    end
  end

  # One digit at screen pixel (sx, sy), each font pixel k screen pixels.
  def Void digit(Int d, Int sx, Int sy, Int k):
    Int bits = glyphs.get(d)
    Int row = 0
    while row < 5:
      Int col = 0
      while col < 3:
        Int shift = 14 - (row * 3 + col)
        if ((bits >> shift) & 1) == 1:
          view.fillRect(sx + col * k, sy + row * k, k, k)
        end
        col = col + 1
      end
      row = row + 1
    end
  end

  # A non-negative number, most significant digit first, in the current
  # colour. Returns the width drawn.
  def Int number(Int n, Int sx, Int sy, Int k):
    Int div = 1
    while n / div >= 10:
      div = div * 10
    end
    Int x = sx
    while div > 0:
      Int d = (n / div) % 10
      digit(d, x, sy, k)
      x = x + 4 * k
      div = div / 10
    end
    return x - sx
  end
end

# Something with a place on the board that can be drawn. depth() is the key
# the painter's sort orders by: further from the camera first, and on an iso
# board that is simply smaller x + y.
interface Drawable
  def Float depth
  def Void draw(Gfx g)
end

# What units and bases have in common: a place, a side, health. team: 0 the
# player, 1 the enemy. flash counts down from the moment of a hit.
class Entity does Drawable
  Int team
  Int isBase
  Float x
  Float y
  Float hp
  Float maxHp
  Float flash

  def Float depth:
    return x + y
  end

  def Int alive:
    if hp > 0.0:
      return 1
    end
    return 0
  end

  # Subclasses draw themselves; an Entity alone is nothing to look at.
  def Void draw(Gfx g):
  end
end

# kind: 0 rock, 1 paper, 2 scissors. A unit with a target walks until it is
# within reach and hits on a cooldown; one with a move order walks to its
# point and ignores the enemy until it gets there. Speed, reach, damage and
# cadence are the prototype's own numbers.
class Unit from Entity
  Int kind
  Float cd
  Entity target = null
  Int ordered
  Float tx
  Float ty
  Int selected

  constructor(Int t, Int k, Float px, Float py):
    team = t
    kind = k
    x = px
    y = py
    maxHp = 40.0
    hp = maxHp
  end

  def Void update(World w, Float dt):
    cd = cd - dt
    if cd < 0.0:
      cd = 0.0
    end

    if target != null and target.alive() == 0:
      target = null
    end

    # The enemy always hunts; the player's units only wake when something is
    # within 2.2 tiles, and not while they are walking somewhere they were
    # sent.
    if target == null and ordered == 0:
      Float sight = 2.2
      if team == 1:
        sight = 1000000000.0
      end
      target = w.nearestEnemy(self, sight)
    end

    Int going = 0
    Float gx = 0.0
    Float gy = 0.0
    Float stop = 0.85
    if target != null:
      gx = target.x
      gy = target.y
      going = 1
    elif ordered == 1:
      gx = tx
      gy = ty
      stop = 0.1
      going = 1
    end

    if going == 1:
      Float dx = gx - x
      Float dy = gy - y
      Float d = Math.sqrt(dx * dx + dy * dy)
      if d > stop:
        Float step = 1.7 * dt
        if step > d - stop:
          step = d - stop
        end
        x = x + dx / d * step
        y = y + dy / d * step
      elif target != null:
        if cd == 0.0:
          w.hit(self, target)
          cd = 0.5
        end
      else
        ordered = 0
      end
    end
  end

  def Void draw(Gfx g):
    if selected == 1:
      g.ring(x, y, 0.28, 0.28, 255, 255, 255, 255)
    end
    g.white = 0
    if flash > 0.0:
      g.white = 1
    end
    g.figure(kind, x, y, team)
    g.white = 0
    g.hpBar(x, y, 0.95, hp, maxHp)
  end
end

# A plinth with a tower on it. It does not fight; losing it loses the game.
class Base from Entity
  constructor(Int t, Float px, Float py):
    team = t
    isBase = 1
    x = px
    y = py
    maxHp = 150.0
    hp = maxHp
  end

  def Void draw(Gfx g):
    g.white = 0
    if flash > 0.0:
      g.white = 1
    end
    g.prism(x, y, 0.55, 0.3, team)
    g.prism(x, y, 0.28, 1.0, team)
    g.white = 0
    g.hpBar(x, y, 1.3, hp, maxHp)
  end
end

# A ring that grows and fades: where a move order went (kind 0), what an
# attack order targeted (1), where a unit died (2).
class Effect from Object
  Float x
  Float y
  Float t
  Float life
  Int kind
  Int team

  constructor(Float px, Float py, Float span, Int k, Int tm):
    x = px
    y = py
    life = span
    kind = k
    team = tm
  end

  def Void draw(Gfx g):
    Float k = t / life
    Int alpha = (1.0 - k) * 255.0
    if kind == 0:
      Float r = 0.22 + k * 0.35
      g.ring(x, y, r, r, 255, 255, 255, alpha)
    elif kind == 1:
      Float r = 0.22 + k * 0.35
      g.ring(x, y, r, r, 230, 86, 79, alpha)
    else
      Float r = 0.1 + k * 0.4
      Int i = team * 3 + 2
      g.ring(x, y, r, r, g.pr.get(i), g.pg.get(i), g.pb.get(i), alpha)
    end
  end
end

# The battlefield and its rules. `things` is in creation order and that order
# is the simulation's: separation and targeting walk it, so it must not depend
# on how the frame is drawn. The painter's sort therefore works on `order`, a
# second list of the same entities.
class World from Object
  List things
  List order
  List fx
  Entity playerBase = null
  Entity enemyBase = null
  Floats gold = null
  Random rng = null
  Int cols = 14
  Int rows = 10
  # 0 running, 1 the player won, 2 the player lost.
  Int over = 0

  def Void setup:
    gold = new Floats(2)
    gold.set(0, 90.0)
    gold.set(1, 90.0)
    rng = new Random()
    rng.seed(7)

    things.append(new Unit(0, 0, 3.2, 3.0))
    things.append(new Unit(0, 1, 3.4, 4.5))
    things.append(new Unit(0, 2, 3.2, 6.0))
    things.append(new Unit(0, 0, 2.6, 5.2))
    things.append(new Unit(1, 2, 10.8, 3.2))
    things.append(new Unit(1, 0, 10.6, 4.6))
    things.append(new Unit(1, 1, 10.8, 6.1))
    things.append(new Unit(1, 1, 11.4, 5.0))
    playerBase = new Base(0, 1.5, 4.5)
    enemyBase = new Base(1, 12.5, 4.5)
    things.append(playerBase)
    things.append(enemyBase)
    rebuildOrder()
  end

  def Void rebuildOrder:
    order = things.slice(0, things.len())
  end

  # 0 up to 1, from the seeded generator, so a scripted run spawns in the
  # same places every time.
  def Float chance:
    return rng.next() / 32767.0
  end

  # A unit of `kind` for `team`, beside its base, if the team has the 30 gold.
  # 1 if one was made.
  def Int trySpawn(Int team, Int kind):
    Int made = 0
    if over == 0 and gold.get(team) >= 30.0:
      gold.set(team, gold.get(team) - 30.0)
      Entity b = playerBase
      Float dir = 1.0
      if team == 1:
        b = enemyBase
        dir = 0.0 - 1.0
      end
      Float sx = b.x + dir * (0.9 + chance() * 0.4)
      Float sy = b.y + (chance() - 0.5) * 1.6
      things.append(new Unit(team, kind, sx, sy))
      rebuildOrder()
      made = 1
    end
    return made
  end

  def Void effect(Float x, Float y, Float life, Int kind, Int team):
    fx.append(new Effect(x, y, life, kind, team))
  end

  def Int selectedCount:
    Int n = 0
    for item in things:
      Entity e = item
      if e.isBase == 0:
        Unit u = e
        n = n + u.selected
      end
    end
    return n
  end

  # Every living unit of the player's selected (1) or not (0).
  def Void selectAll(Int on):
    for item in things:
      Entity e = item
      if e.isBase == 0 and e.team == 0:
        Unit u = e
        u.selected = on
      end
    end
  end

  # Selected units go for `target` and nothing else until it is dead.
  def Void orderAttack(Entity target):
    for item in things:
      Entity e = item
      if e.isBase == 0:
        Unit u = e
        if u.selected == 1:
          u.target = target
          u.ordered = 0
        end
      end
    end
    effect(target.x, target.y, 0.4, 1, 0)
  end

  # Selected units walk to (wx, wy), spread on a circle so they do not all
  # want the same spot -- radius 0.3 * sqrt(n), as in the prototype.
  def Void orderMove(Float wx, Float wy):
    Int n = selectedCount()
    if n > 0:
      Float r = 0.0
      if n > 1:
        r = 0.3 * Math.sqrt(n)
      end
      Int i = 0
      for item in things:
        Entity e = item
        if e.isBase == 0:
          Unit u = e
          if u.selected == 1:
            Float a = i * 2.0 * Math.pi() / n
            u.tx = clampTo(wx + Math.cos(a) * r, 0.3, cols - 0.3)
            u.ty = clampTo(wy + Math.sin(a) * r, 0.3, rows - 0.3)
            u.ordered = 1
            u.target = null
            i = i + 1
          end
        end
      end
      effect(wx, wy, 0.5, 0, 0)
    end
  end

  # 1 when a beats b: rock breaks scissors, scissors cut paper, paper covers
  # rock. With rock 0, paper 1, scissors 2, a beats (a + 2) mod 3.
  def Int beats(Int a, Int b):
    if (a + 2) % 3 == b:
      return 1
    end
    return 0
  end

  def Void hit(Entity a, Entity b):
    Float m = 1.0
    if b.isBase == 0:
      Unit ua = a
      Unit ub = b
      if beats(ua.kind, ub.kind) == 1:
        m = 3.0
      elif beats(ub.kind, ua.kind) == 1:
        m = 1.0 / 3.0
      end
    end
    b.hp = b.hp - 8.0 * m
    b.flash = 0.12
  end

  # The closest living enemy of u within maxD tiles, or null. Real distances,
  # not squares: two enemies almost equally far can round to the same square
  # root, and the prototype then keeps the first it found where comparing
  # squares picks the other. Which of two is "closest" decides who a unit
  # fights, so the tie has to break the way the prototype's does.
  def Entity nearestEnemy(Entity u, Float maxD):
    Entity best = null
    Float bd = maxD
    for item in things:
      Entity e = item
      if e.team != u.team and e.alive() == 1:
        Float dx = e.x - u.x
        Float dy = e.y - u.y
        Float d = Math.sqrt(dx * dx + dy * dy)
        if d < bd:
          bd = d
          best = e
        end
      end
    end
    return best
  end

  # No pathfinding: units that overlap are pushed apart.
  def Void separate:
    Int n = things.len()
    Int i = 0
    while i < n:
      Entity a = things.get(i)
      if a.isBase == 0:
        Int j = i + 1
        while j < n:
          Entity b = things.get(j)
          if b.isBase == 0:
            Float dx = b.x - a.x
            Float dy = b.y - a.y
            Float d = Math.sqrt(dx * dx + dy * dy)
            if d == 0.0:
              d = 0.001
            end
            if d < 0.45:
              Float p = (0.45 - d) / 2.0
              Float nx = dx / d * p
              Float ny = dy / d * p
              a.x = a.x - nx
              a.y = a.y - ny
              b.x = b.x + nx
              b.y = b.y + ny
            end
          end
          j = j + 1
        end
      end
      i = i + 1
    end
  end

  def Float clampTo(Float v, Float lo, Float hi):
    if v < lo:
      return lo
    end
    if v > hi:
      return hi
    end
    return v
  end

  # Drop the dead, leaving a ring where each fell. A dying unit lets go of
  # its target on the way out: two units that killed each other in one step
  # would otherwise hold each other alive for ever, and reference counting
  # cannot see a cycle.
  def Void clearDead:
    Int dead = 0
    for item in things:
      Entity e = item
      if e.alive() == 0 and e.isBase == 0:
        dead = dead + 1
      end
    end
    if dead > 0:
      List keep
      for item in things:
        Entity e = item
        if e.alive() == 1 or e.isBase == 1:
          keep.append(e)
        else
          Unit gone = e
          gone.target = null
          effect(gone.x, gone.y, 0.45, 2, gone.team)
        end
      end
      things = keep
      rebuildOrder()
    end
  end

  def Void updateEffects(Float dt):
    Int done = 0
    for item in fx:
      Effect f = item
      f.t = f.t + dt
      if f.t >= f.life:
        done = done + 1
      end
    end
    if done > 0:
      List keep
      for item in fx:
        Effect f = item
        if f.t < f.life:
          keep.append(f)
        end
      end
      fx = keep
    end
  end

  def Void update(Float dt):
    if over == 0:
      gold.set(0, gold.get(0) + 6.0 * dt)
      gold.set(1, gold.get(1) + 6.0 * dt)

      for item in things:
        Entity e = item
        e.flash = e.flash - dt
        if e.flash < 0.0:
          e.flash = 0.0
        end
        if e.isBase == 0:
          Unit u = e
          u.update(self, dt)
        end
      end

      separate()
      for item in things:
        Entity e = item
        if e.isBase == 0:
          e.x = clampTo(e.x, 0.3, cols - 0.3)
          e.y = clampTo(e.y, 0.3, rows - 0.3)
        end
      end

      clearDead()
      updateEffects(dt)

      if enemyBase.alive() == 0:
        over = 1
      elif playerBase.alive() == 0:
        over = 2
      end
    end
  end

  # Insertion sort of `order` on depth. It is nearly in order from one frame
  # to the next, which is the case insertion sort is quickest at.
  def Void sortForDrawing:
    Int i = 1
    while i < order.len():
      Drawable key = order.get(i)
      Float kd = key.depth()
      Int j = i - 1
      Int moving = 1
      while j >= 0 and moving == 1:
        Drawable other = order.get(j)
        if other.depth() > kd:
          order.set(j + 1, other)
          j = j - 1
        else
          moving = 0
        end
      end
      order.set(j + 1, key)
      i = i + 1
    end
  end

  def Void draw(Gfx g):
    sortForDrawing()
    for item in order:
      Drawable d = item
      d.draw(g)
    end
    for item in fx:
      Effect f = item
      f.draw(g)
    end
  end

  # Every unit's state, one per line, in simulation order: what a second
  # implementation of the rules is compared against. Positions and health are
  # printed as fixed-point integers (x 10^12, hp 10^9) because a float prints
  # with six digits, which hides the last-bit differences this exists to find.
  def String dump:
    String s = ""
    for item in things:
      Entity e = item
      if e.isBase == 0:
        Unit u = e
        Int64 fx = u.x * 1000000000000.0
        Int64 fy = u.y * 1000000000000.0
        Int64 fh = u.hp * 1000000000.0
        s = s + "${u.team} ${u.kind} ${fx} ${fy} ${fh}\n"
      end
    end
    return s
  end

  # One line: who is left of each kind, the bases, gold and selection.
  def String summary:
    Int p0 = 0
    Int p1 = 0
    Int p2 = 0
    Int e0 = 0
    Int e1 = 0
    Int e2 = 0
    for item in things:
      Entity e = item
      if e.isBase == 0:
        Unit u = e
        if u.team == 0 and u.kind == 0:
          p0 = p0 + 1
        elif u.team == 0 and u.kind == 1:
          p1 = p1 + 1
        elif u.team == 0 and u.kind == 2:
          p2 = p2 + 1
        elif u.kind == 0:
          e0 = e0 + 1
        elif u.kind == 1:
          e1 = e1 + 1
        else
          e2 = e2 + 1
        end
      end
    end
    Int g = gold.get(0)
    return "player R${p0} P${p1} S${p2}  enemy R${e0} P${e1} S${e2}  bases ${playerBase.hp} ${enemyBase.hp}  gold ${g}  selected ${selectedCount()}  over ${over}"
  end

  # Where each of the player's units is, and whether it is selected, walking
  # somewhere, or after something: what the input tests look at.
  def String units:
    String s = ""
    for item in things:
      Entity e = item
      if e.isBase == 0 and e.team == 0:
        Unit u = e
        String doing = "idle"
        if u.ordered == 1:
          doing = "moving"
        elif u.target != null:
          doing = "fighting"
        end
        Int ix = u.x * 100.0
        Int iy = u.y * 100.0
        s = s + "unit ${u.kind} at ${ix} ${iy} selected ${u.selected} ${doing}\n"
      end
    end
    return s
  end
end

# The spawn buttons along the bottom of the window. Their geometry lives here
# so drawing them and clicking them cannot disagree.
class Hud from Object
  Int w
  Int h
  Int bw = 132
  Int bh = 56
  Int gap = 12

  constructor(Int ww, Int hh):
    w = ww
    h = hh
  end

  def Int left(Int i):
    return w / 2 - (3 * bw + 2 * gap) / 2 + i * (bw + gap)
  end

  def Int top:
    return h - bh - 10
  end

  # Which button (0, 1, 2) is under (mx, my), or -1.
  def Int buttonAt(Int mx, Int my):
    Int found = 0 - 1
    if my >= top() and my < top() + bh:
      Int i = 0
      while i < 3:
        if mx >= left(i) and mx < left(i) + bw:
          found = i
        end
        i = i + 1
      end
    end
    return found
  end

  def Void draw(Gfx g, World world):
    Renderer v = g.view
    Int afford = 0
    if world.gold.get(0) >= 30.0:
      afford = 1
    end

    # Gold, top left, after a coin.
    v.setColor(242, 179, 61)
    v.fillQuad(24, 16, 34, 26, 24, 36, 14, 26)
    v.setColor(231, 226, 214)
    Int gold = world.gold.get(0)
    g.number(gold, 44, 16, 4)

    # How many are selected, top right, after a ring like the one they wear.
    Int n = world.selectedCount()
    v.setColor(231, 226, 214)
    Int width = g.number(n, 0, 0 - 100, 4)
    Int nx = w - 20 - width
    g.number(n, nx, 16, 4)
    Float rx = nx - 22.0
    Float ry = 26.0
    Int i = 0
    Float px = rx + 12.0
    Float py = ry
    while i <= 32:
      Float t = i * Math.pi() / 16.0
      Float qx = rx + 12.0 * Math.cos(t)
      Float qy = ry + 6.0 * Math.sin(t)
      v.line(px, py, qx, qy)
      px = qx
      py = qy
      i = i + 1
    end

    Int b = 0
    while b < 3:
      Int bx = left(b)
      Int by = top()
      v.setColor(44, 53, 64)
      v.fillRect(bx, by, bw, bh)
      v.setColor(58, 68, 82)
      v.line(bx, by, bx + bw - 1, by)
      v.line(bx + bw - 1, by, bx + bw - 1, by + bh - 1)
      v.line(bx + bw - 1, by + bh - 1, bx, by + bh - 1)
      v.line(bx, by + bh - 1, bx, by)

      # The key that does the same, small, in the corner.
      v.setColor(120, 128, 140)
      g.digit(b + 1, bx + 6, by + 6, 2)

      # The figure itself, drawn by the same code as the board's, standing on
      # the tile point under this spot of screen.
      Float ix = bx + 42.0
      Float iy = by + bh - 12.0
      g.dim = 1 - afford
      g.figure(b, g.cam.worldX(ix, iy), g.cam.worldY(ix, iy), 0)
      g.dim = 0

      if afford == 1:
        v.setColor(242, 179, 61)
      else
        v.setColor(110, 116, 126)
      end
      g.number(30, bx + bw - 44, by + 18, 4)
      b = b + 1
    end
  end
end

# Mouse and keyboard, turned into the prototype's gestures: a press and
# release in one place is a tap, one that moved more than 10 pixels is a box.
class Controls from Object
  World world = null
  Camera cam = null
  Hud hud = null
  Int dragging = 0
  Int boxing = 0
  Int x0
  Int y0
  Int x
  Int y

  constructor(World w, Camera c, Hud h):
    world = w
    cam = c
    hud = h
  end

  # Handles every event waiting. 0 once the player has asked to quit.
  def Int pump(Sdl sdl):
    Int keep = 1
    while sdl.poll() == 1:
      if sdl.isQuit() == 1:
        keep = 0
      elif sdl.isKeyDown() == 1:
        if key(sdl.key()) == 0:
          keep = 0
        end
      elif sdl.isMouseDown() == 1:
        press(sdl.mouseX(), sdl.mouseY())
      elif sdl.isMouseMove() == 1:
        move(sdl.mouseX(), sdl.mouseY())
      elif sdl.isMouseUp() == 1:
        lift(sdl.mouseX(), sdl.mouseY(), sdl.mouseButton())
      end
    end
    return keep
  end

  # 1 2 3 spawn, A selects all, Esc clears, Q quits.
  def Int key(Int k):
    Int keep = 1
    if k >= 49 and k <= 51:
      world.trySpawn(0, k - 49)
    elif k == 97:
      world.selectAll(1)
    elif k == 27:
      world.selectAll(0)
    elif k == 113:
      keep = 0
    end
    return keep
  end

  def Void press(Int mx, Int my):
    Int b = hud.buttonAt(mx, my)
    if b >= 0:
      world.trySpawn(0, b)
    else
      dragging = 1
      boxing = 0
      x0 = mx
      y0 = my
      x = mx
      y = my
    end
  end

  def Void move(Int mx, Int my):
    if dragging == 1:
      x = mx
      y = my
      Float dx = x - x0
      Float dy = y - y0
      if Math.sqrt(dx * dx + dy * dy) > 10.0:
        boxing = 1
      end
    end
  end

  def Void lift(Int mx, Int my, Int button):
    if dragging == 1:
      x = mx
      y = my
      if boxing == 1:
        boxSelect()
      else
        Int force = 0
        if button == 3:
          force = 1
        end
        tap(mx, my, force)
      end
      dragging = 0
      boxing = 0
    end
  end

  # The entity nearest a screen point, measured to its body rather than its
  # feet, within 0.4 of a tile's width; null if nothing is that close.
  def Entity pickAt(Int sx, Int sy):
    Entity best = null
    Float bd = cam.tw * 0.4
    for item in world.things:
      Entity e = item
      Float z = 0.3
      if e.isBase == 1:
        z = 0.6
      end
      Float dx = sx - cam.screenX(e.x, e.y)
      Float dy = sy - cam.screenY(e.x, e.y, z)
      Float d = Math.sqrt(dx * dx + dy * dy)
      if d < bd:
        bd = d
        best = e
      end
    end
    return best
  end

  # A tap on one of your units toggles it. Otherwise, with something
  # selected, a tap on an enemy attacks it and a tap anywhere else sends the
  # selection there. `force` is the right button: always an order.
  def Void tap(Int sx, Int sy, Int force):
    if world.over == 0:
      Entity e = pickAt(sx, sy)
      if e != null and e.team == 0 and e.isBase == 0 and force == 0:
        Unit u = e
        u.selected = 1 - u.selected
      elif world.selectedCount() > 0:
        if e != null and e.team == 1:
          world.orderAttack(e)
        else
          world.orderMove(cam.worldX(sx, sy), cam.worldY(sx, sy))
        end
      end
    end
  end

  # The box replaces the selection with the player's units whose bodies are
  # inside it.
  def Void boxSelect:
    Int lx = x0
    Int hx = x
    if hx < lx:
      lx = x
      hx = x0
    end
    Int ly = y0
    Int hy = y
    if hy < ly:
      ly = y
      hy = y0
    end
    for item in world.things:
      Entity e = item
      if e.isBase == 0 and e.team == 0:
        Unit u = e
        Float sx = cam.screenX(u.x, u.y)
        Float sy = cam.screenY(u.x, u.y, 0.3)
        u.selected = 0
        if sx >= lx and sx <= hx and sy >= ly and sy <= hy:
          u.selected = 1
        end
      end
    end
  end

  def Void draw(Gfx g):
    if dragging == 1 and boxing == 1:
      g.view.setColor(255, 255, 255)
      g.dashed(x0, y0, x, y0)
      g.dashed(x, y0, x, y)
      g.dashed(x, y, x0, y)
      g.dashed(x0, y, x0, y0)
    end
  end
end

# One line of a play file: at step `frame`, do `cmd` with up to six numbers.
class Cue from Object
  Int frame
  String cmd = ""
  Floats a = null
end

# Scripted input for --play. Each line is "<step> <command> <numbers>":
#
#   12 key 49              a key, by SDL keycode (49 is "1")
#   20 click 3.2 3.0 0.3   left click on tile point (x, y) at height z
#   20 rclick 9 4 0.3      the same with the right button
#   30 drag 1 2 5 7        press on tile point (1, 2), move to (5, 7), release
#   40 tap 480 600         left click at a screen pixel, for the buttons
#
# World points are turned into screen pixels with the game's own camera and
# pushed into SDL's queue as real events, so a script goes through the very
# code a mouse does. Lines starting "#" are comments.
class Script from Object
  List cues
  Int next = 0

  def Void load(String path):
    File f
    if f.open(path, "r") == 0:
      throw "cannot open ${path}"
    end
    while f.eof() == 0:
      String line = f.readLine().trim()
      if line.len() > 0:
        List words = line.split(" ")
        String first = words.get(0)
        if first != "#":
          Cue c = new Cue()
          c.frame = first.toInt()
          c.cmd = words.get(1)
          c.a = new Floats(6)
          Int i = 2
          while i < words.len() and i < 8:
            String w = words.get(i)
            c.a.set(i - 2, w.toFloat())
            i = i + 1
          end
          cues.append(c)
        end
      end
    end
    f.close()
  end

  # Queues everything due by this step.
  def Void push(Int frame, Sdl sdl, Camera cam):
    Int more = 1
    while more == 1 and next < cues.len():
      Cue c = cues.get(next)
      if c.frame <= frame:
        send(c, sdl, cam)
        next = next + 1
      else
        more = 0
      end
    end
  end

  def Void send(Cue c, Sdl sdl, Camera cam):
    Floats a = c.a
    if c.cmd == "key":
      sdl.pushKey(a.get(0))
    elif c.cmd == "click" or c.cmd == "rclick":
      Int button = 1
      if c.cmd == "rclick":
        button = 3
      end
      Float sx = cam.screenX(a.get(0), a.get(1))
      Float sy = cam.screenY(a.get(0), a.get(1), a.get(2))
      sdl.pushMouse(0, sx, sy, button)
      sdl.pushMouse(1, sx, sy, button)
    elif c.cmd == "drag":
      Float sx0 = cam.screenX(a.get(0), a.get(1))
      Float sy0 = cam.screenY(a.get(0), a.get(1), 0.0)
      Float sx1 = cam.screenX(a.get(2), a.get(3))
      Float sy1 = cam.screenY(a.get(2), a.get(3), 0.0)
      sdl.pushMouse(0, sx0, sy0, 1)
      sdl.pushMouse(2, sx1, sy1, 1)
      sdl.pushMouse(1, sx1, sy1, 1)
    elif c.cmd == "tap":
      sdl.pushMouse(0, a.get(0), a.get(1), 1)
      sdl.pushMouse(1, a.get(0), a.get(1), 1)
    else
      throw "unknown command '${c.cmd}' in play file"
    end
  end
end

class Main from IO
  def main:
    Sdl sdl = new Sdl()
    Int windowW = 960
    Int windowH = 640
    Window win = new Window(sdl, "catmint RPS RTS", windowW, windowH)
    Renderer view = new Renderer(win)
    Float fw = windowW
    Float fh = windowH
    Camera cam = new Camera(14, 10, 64.0, 32.0, fw, fh)
    Gfx gfx = new Gfx(view, cam)
    World world = new World()
    world.setup()
    Hud hud = new Hud(windowW, windowH)
    Controls controls = new Controls(world, cam, hud)

    Int frames = 0
    Int dump = 0
    String shot = ""
    Script script = null
    Int a = 1
    while a < args():
      if arg(a) == "--frames":
        frames = arg(a + 1).toInt()
        a = a + 1
      elif arg(a) == "--shot":
        shot = arg(a + 1)
        a = a + 1
      elif arg(a) == "--dump":
        dump = 1
      elif arg(a) == "--play":
        script = new Script()
        script.load(arg(a + 1))
        a = a + 1
      end
      a = a + 1
    end

    # Fixed steps first: input from the script, if there is one, then the
    # simulation, exactly as the interactive loop does it but without drawing
    # or waiting, so a run is fast and the same every time.
    Int before = allocated()
    Int keep = 1
    Int step = 0
    while step < frames and keep == 1:
      if script != null:
        script.push(step, sdl, cam)
      end
      keep = controls.pump(sdl)
      world.update(1.0 / 60.0)
      step = step + 1
    end
    if frames > 0:
      out("after ${step}: ${world.summary()}  objects +${allocated() - before}\n")
      if dump == 1:
        out(world.dump())
      end
      if script != null:
        out(world.units())
      end
    end

    Int last = sdl.ticks()
    while keep == 1:
      keep = controls.pump(sdl)

      Int now = sdl.ticks()
      Float dt = (now - last) / 1000.0
      last = now
      if dt > 0.05:
        dt = 0.05
      end
      if shot.len() == 0:
        world.update(dt)
      end

      view.clear(35, 42, 51)
      gfx.grid()
      world.draw(gfx)
      controls.draw(gfx)
      hud.draw(gfx, world)
      if shot.len() > 0:
        view.saveBMP(shot)
        keep = 0
      end
      view.present()
      sdl.delay(16)
    end

    out("closed cleanly\n")
  end
end
