#!/bin/sh
# Each case must fail to compile, and say what it says. A refusal that
# compiled, or failed for another reason, is a failure here.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failed=0

refuse() {
  name=$1; want=$2
  cat > "$work/$name.cm"
  if ../catmintc "$work/$name.cm" -o "$work/$name" > "$work/$name.log" 2>&1; then
    echo "$name: compiled, and should have been refused"
    failed=1
  elif ! grep -qF -- "$want" "$work/$name.log"; then
    echo "$name: refused, but not saying \"$want\":"
    grep -i "error" "$work/$name.log" | head -2
    failed=1
  fi
}

refuse wrong_offset "is at offset 4 by C's layout rule, and the declaration says 8" <<'CM'
extern struct P @ 8
  Int32 a @ 0
  Int32 b @ 8
end
class Main from IO
  def main:
    P p
  end
end
CM

refuse wrong_size "is 8 bytes by C's layout rule, and the declaration says 12" <<'CM'
extern struct P @ 12
  Int32 a
  Int32 b
end
class Main from IO
  def main:
    P p
  end
end
CM

refuse string_field "which has no C layout" <<'CM'
extern struct P
  String name
end
class Main from IO
  def main:
    P p
  end
end
CM

refuse holds_itself "holds itself by value" <<'CM'
extern struct P
  Int32 a
  P again
end
class Main from IO
  def main:
    P p
  end
end
CM

refuse opaque_by_value "holds an opaque" <<'CM'
extern struct Handle
end
extern struct P
  Handle h
end
class Main from IO
  def main:
    P p
  end
end
CM

refuse new_opaque "is opaque" <<'CM'
extern struct Handle
end
class Main from IO
  def main:
    Handle h = new Handle()
  end
end
CM

refuse at_outside_unsafe "needs 'unsafe:'" <<'CM'
extern struct P
  Int32 a
end
class Main from IO
  def main:
    Ptr raw = null
    P p = P.at(raw)
  end
end
CM

refuse no_methods "has no methods" <<'CM'
extern struct P
  Int32 a
end
class Main from IO
  def main:
    Int n = P.size()
  end
end
CM

refuse float_to_int "takes an integer as 'x' and is given a Float" <<'CM'
extern class Libc
  def Int abs(Int x)
end
class Main from IO
  def main:
    unsafe:
      Libc.abs(2.5)
    end
  end
end
CM

refuse uint_in_catmint "is a C type, for extern declarations only; in catmint code use Int64" <<'CM'
class Main from IO
  def main:
    UInt32 x = 5
  end
end
CM

refuse whole_array "is an array of 4; use it an element at a time" <<'CM'
extern struct P
  UInt8 bytes[4]
end
class Main from IO
  def main:
    P p
    out("${p.bytes}\n")
  end
end
CM

refuse fromc_outside_unsafe "'String.fromC' turns a Ptr into text" <<'CM'
class Main from IO
  def main:
    String s = String.fromC(null, 4)
  end
end
CM

refuse fromc_from_ints "'String.fromC' reads text from a Ptr or a Bytes, not from a Ints" <<'CM'
class Main from IO
  def main:
    Ints numbers = new Ints(4)
    unsafe:
      String s = String.fromC(numbers, 4)
    end
  end
end
CM

refuse extern_returns_array "returns 'Bytes', but C returns a pointer, not a catmint array" <<'CM'
extern class Libc
  def Bytes getenv(String name)
end
class Main from IO
  def main:
    out("x\n")
  end
end
CM

refuse variadic_string "passes 'String text' as a variable argument" <<'CM'
extern class Libc
  def Int snprintf_text = snprintf(Ptr buffer, UInt64 size, String format, ... String text)
end
class Main from IO
  def main:
    out("x\n")
  end
end
CM

refuse variadic_float32 "(a float is promoted to a double)" <<'CM'
extern class Libc
  def Int snprintf_f = snprintf(Ptr buffer, UInt64 size, String format, ... Float32 x)
end
class Main from IO
  def main:
    out("x\n")
  end
end
CM

refuse variadic_wrong_argument "takes an integer as" <<'CM'
extern class Libc
  def Int fcntl_dup = fcntl(Int fd, Int cmd, ... Int minimum)
end
class Main from IO
  def main:
    unsafe:
      Libc.fcntl_dup(1, 0, 2.5)
    end
  end
end
CM

refuse callback_wrong_signature "is (Ptr left) Int, but Compare is (Ptr left, Ptr right) Int" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
extern class Libc
  def Void qsort(Ptr base, UInt64 count, UInt64 size, Compare order)
end
class Order
  static def Int one(Ptr left):
    return 0
  end
end
class Main from IO
  def main:
    unsafe:
      Libc.qsort(null, 0, 8, Order.one)
    end
  end
end
CM

refuse callback_wrong_result "is (Ptr left, Ptr right) Void, but Compare is (Ptr left, Ptr right) Int" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
extern class Libc
  def Void qsort(Ptr base, UInt64 count, UInt64 size, Compare order)
end
class Order
  static def Void none(Ptr left, Ptr right):
  end
end
class Main from IO
  def main:
    unsafe:
      Libc.qsort(null, 0, 8, Order.none)
    end
  end
end
CM

refuse callback_not_static "cannot be a callback: C has no object to call it on" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
extern class Libc
  def Void qsort(Ptr base, UInt64 count, UInt64 size, Compare order)
end
class Order
  def Int ascending(Ptr left, Ptr right):
    return 0
  end
end
class Main from IO
  def main:
    unsafe:
      Libc.qsort(null, 0, 8, Order.ascending)
    end
  end
end
CM

refuse callback_builtin "cannot be a callback" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
extern class Libc
  def Void qsort(Ptr base, UInt64 count, UInt64 size, Compare order)
end
class Main from IO
  def main:
    unsafe:
      Libc.qsort(null, 0, 8, Math.abs)
    end
  end
end
CM

refuse callback_no_such_method "has no method 'nothing'" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
extern class Libc
  def Void qsort(Ptr base, UInt64 count, UInt64 size, Compare order)
end
class Order
end
class Main from IO
  def main:
    unsafe:
      Libc.qsort(null, 0, 8, Order.nothing)
    end
  end
end
CM

refuse callback_given_a_value "pass a static method by naming it" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
extern class Libc
  def Void qsort(Ptr base, UInt64 count, UInt64 size, Compare order)
end
class Main from IO
  def main:
    Int whatever = 5
    unsafe:
      Libc.qsort(null, 0, 8, whatever)
    end
  end
end
CM

refuse callback_type_in_a_local "is a callback type: it can only be the type of a parameter of an extern function" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
class Main from IO
  def main:
    Compare held = null
  end
end
CM

refuse callback_type_in_a_field "is a callback type: it can only be the type of a parameter of an extern function" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
class Holder
  Compare order
end
class Main from IO
  def main:
    out("x\n")
  end
end
CM

refuse callback_type_in_a_method "is a callback type: it can only be the type of a parameter of an extern function" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
class Main from IO
  def take(Compare order):
    return 0
  end
  def main:
    out("x\n")
  end
end
CM

refuse callback_takes_a_string "C can pass a callback a number, a Ptr or an extern struct" <<'CM'
extern def Bad(String text) Int
class Main from IO
  def main:
    out("x\n")
  end
end
CM

refuse callback_returns_a_string "a callback can return Void, a number or a Ptr" <<'CM'
extern def Bad(Ptr p) String
class Main from IO
  def main:
    out("x\n")
  end
end
CM

refuse handles_get_outside_unsafe "'Handles.get' turns a Ptr into an object" <<'CM'
class Main from IO
  def main:
    Object o = Handles.get(null)
  end
end
CM

refuse callback_new "is a callback type: it has no instances" <<'CM'
extern def Compare(Ptr left, Ptr right) Int
class Main from IO
  def main:
    Object o = new Compare()
  end
end
CM

exit $failed
