# 'and' and 'or' stop as soon as the answer is known, which is what makes a
# null guard safe to write.

class Box
  Int value
end

class Main from IO
  Int calls

  def Int probe(Int result):
    calls = calls + 1
    return result
  end

  def main:
    out("1 and 1 = " + (1 and 1) + "\n")
    out("1 and 0 = " + (1 and 0) + "\n")
    out("0 and 1 = " + (0 and 1) + "\n")
    out("0 or 0 = " + (0 or 0) + "\n")
    out("0 or 1 = " + (0 or 1) + "\n")
    out("1 or 0 = " + (1 or 0) + "\n")

    # The right side is not evaluated when the left already decides.
    calls = 0
    if 0 and probe(1):
      out("unreachable\n")
    end
    out("calls after false and = " + calls + "\n")

    calls = 0
    if 1 or probe(1):
      out("taken\n")
    end
    out("calls after true or = " + calls + "\n")

    # The guard that could not be written before: the second test only runs
    # when the first says the reference is there.
    Box present
    present.value = 3
    Box absent = null

    if absent != null and absent.value > 0:
      out("wrong\n")
    else
      out("null guard held\n")
    end

    if present != null and present.value > 0:
      out("present guard held\n")
    end

    # They bind looser than comparison, so no parentheses are needed.
    Int a = 5
    if a > 1 and a < 10 or a == 99:
      out("range held\n")
    end

    # '&' and '|' are still the bitwise operators and still evaluate both.
    out("3 & 1 = " + (3 & 1) + "\n")
    out("2 | 1 = " + (2 | 1) + "\n")
  end
end
