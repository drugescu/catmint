# A program run in the background, for a window that cannot wait for it. A Job
# starts a program without a shell parsing its arguments, sends what it prints --
# standard output and standard error, in order, to one file -- and is polled once
# a frame: poll() never waits, and gives back the lines that have arrived since.
# What is expected:
#   - arguments are the program's own, whatever is in them: `;`, `$HOME` and `*`
#     are printed as they are;
#   - the exit status is the program's, 128 and the signal if a signal ended it,
#     127 if there is no such program, and a folder that does not exist is a failure
#     that says so rather than the program running somewhere else;
#   - the program's input is empty, so one that reads it ends instead of waiting;
#   - a line is given whole: the last one without a newline when the program ends,
#     one longer than a read, and 100,000 of them, in order; a NUL in the output is
#     a ?; an empty line is a line;
#   - poll() returns at once while the program is still going, and running() stays
#     1 until the program has ended and everything it printed has been given;
#   - stop() asks the program to end, and asked again, makes it; a program that
#     prints without end is stopped when it has printed `limit` bytes, with a line
#     saying so;
#   - the output file is there while it runs and gone when it is over, in a folder
#     only the user can enter; descriptors are given back, so 120 jobs one after
#     another all start (in room for 50 descriptors);
#   - an empty program list, or starting one that is running, is refused.

using job
using files

# Only to lower how many descriptors this program may have open, so that a job
# which keeps one shows on any machine, not only where the limit is 256.
extern class Limits
  def Int getrlimit(Int resource, Bytes limits)
  def Int setrlimit(Int resource, Bytes limits)
  def Int setenv(String name, String value, Int overwrite)
end

class Main from IO
  List last = null
  # The most lines any one poll gave, in count().
  Int biggest

  # Drain without keeping the lines: how many there were.
  def Int count(Job j):
    Int sum = 0
    biggest = 0
    while j.running() == 1:
      List got = j.poll()
      if got.len() > biggest:
        biggest = got.len()
      end
      sum = sum + got.len()
      if got.len() == 0:
        sleep(2)
      end
    end
    return sum
  end

  def String yn(Int b):
    if b == 1:
      return "yes"
    end
    return "no"
  end

  # Poll the way a window does, once a frame and never waiting, until it is over.
  def List drain(Job j):
    List all = new List()
    while j.running() == 1:
      List got = j.poll()
      Int i = 0
      while i < got.len():
        all.append(got.get(i))
        i = i + 1
      end
      if got.len() == 0:
        sleep(2)
      end
    end
    return all
  end

  def Job run(String label, List argv, String dir):
    Job j = new Job()
    if j.start(argv, dir) == 0:
      out("${label}: did not start\n")
      last = new List()
      return j
    end
    last = drain(j)
    out("${label}: code ${j.code()}\n")
    return j
  end

  def Void lines:
    Int i = 0
    while i < last.len():
      String line = last.get(i)
      out("  [${line}]\n")
      i = i + 1
    end
  end

  def String first:
    if last.len() == 0:
      return ""
    end
    String s = last.get(0)
    return s
  end

  def List of(String a):
    List l = new List()
    l.append(a)
    return l
  end

  def List of2(String a, String b):
    List l = of(a)
    l.append(b)
    return l
  end

  def List of3(String a, String b, String c):
    List l = of2(a, b)
    l.append(c)
    return l
  end

  def List sh(String script):
    List l = of2("sh", "-c")
    l.append(script)
    return l
  end

  # Lines joined with commas.
  def String joined(List l):
    String s = ""
    Int i = 0
    while i < l.len():
      if i > 0:
        s = s + ","
      end
      String item = l.get(i)
      s = s + item
      i = i + 1
    end
    return s
  end

  def main:
    Job fresh = new Job()
    List none = fresh.poll()
    out("fresh: running ${fresh.running()}, code ${fresh.code()}, poll gives ${none.len()}\n")

    # Arguments are not parsed.
    List e = of2("echo", "hello world")
    e.append("a;echo injected")
    e.append("$HOME")
    e.append("*")
    run("echo", e, "")
    lines()

    run("exit 3", sh("exit 3"), "")
    out("  no lines: ${yn(last.len() == 0)}\n")

    run("both streams", sh("echo one; echo two 1>&2; echo; echo three"), "")
    lines()

    run("no such program", of("no-such-program-xyz"), "")
    out("  said something: ${yn(last.len() > 0)}\n")

    # A path that is not there is 127 as a bare name is, with its own words; one that is
    # there and cannot be run is the shell's 126.
    run("no such path", of("/no/such/program"), "")
    lines()
    run("not a program", of("/etc/hosts"), "")
    out("  said something: ${yn(last.len() > 0)}\n")

    run("folder /", of("pwd"), "/")
    lines()

    # With no folder given it is the one we are in, which pwd run without a Job says.
    run("this folder", of("pwd"), "")
    String here = first()
    Process whereAmI = new Process()
    whereAmI.openArgs(of("pwd"))
    String mine = whereAmI.readLine()
    while whereAmI.eof() == 0:
      String more = whereAmI.readLine()
    end
    whereAmI.finish()
    out("  same as ours: ${yn(here.equals(mine))}\n")

    run("no such folder", of2("echo", "ran"), "/no/such/folder")
    out("  program ran: ${yn(first().equals("ran"))}\n")
    out("  said something: ${yn(last.len() > 0)}\n")

    run("input is empty", of("cat"), "")
    out("  no lines: ${yn(last.len() == 0)}\n")

    run("no newline at the end", sh("printf 'no newline'"), "")
    lines()

    run("NUL in the output", sh("printf 'a\\0b\\n'"), "")
    lines()

    # 100,000 lines, in order, across reads that cut them anywhere.
    run("100000 lines", of3("seq", "1", "100000"), "")
    Int ordered = 1
    Int n = 0
    while n < last.len():
      String got = last.get(n)
      if got.equals("${n + 1}") == 0:
        ordered = 0
      end
      n = n + 1
    end
    out("  ${last.len()} lines, in order: ${yn(ordered)}\n")

    # One line longer than a read.
    run("a long line", sh("head -c 10000 /dev/zero | tr '\\0' x; echo"), "")
    String longest = first()
    Int allX = 1
    n = 0
    while n < longest.len():
      if longest.at(n) != 120:
        allX = 0
      end
      n = n + 1
    end
    out("  ${last.len()} line of ${longest.len()}, all x: ${yn(allX)}\n")

    # poll() does not wait for the program.
    Job slow = new Job()
    slow.start(sh("sleep 1; echo late"), "")
    Int began = ticks()
    List early = slow.poll()
    Int took = ticks() - began
    out("sleeping: first poll gave ${early.len()} lines, running ${slow.running()}, quick ${yn(took < 200)}\n")
    last = drain(slow)
    out("sleeping: code ${slow.code()}\n")
    lines()

    # stop() asks, and asking again insists.
    Job sleeper = new Job()
    sleeper.start(of2("sleep", "30"), "")
    sleeper.stop()
    began = ticks()
    last = drain(sleeper)
    out("stopped: code ${sleeper.code()}, quick ${yn(ticks() - began < 5000)}\n")

    Job stubborn = new Job()
    stubborn.start(sh("trap '' TERM; sleep 3"), "")
    sleep(300)
    stubborn.stop()
    sleep(100)
    List ignored = stubborn.poll()
    out("asked once: still running ${stubborn.running()}\n")
    stubborn.stop()
    began = ticks()
    last = drain(stubborn)
    out("asked twice: code ${stubborn.code()}, quick ${yn(ticks() - began < 2000)}\n")

    # stop() reaches what the program started.
    Job parent = new Job()
    parent.start(sh("sleep 30 & echo $!; wait"), "")
    List said = new List()
    while said.len() == 0 and parent.running() == 1:
      said = parent.poll()
      sleep(2)
    end
    String childPid = said.get(0)
    parent.stop()
    last = drain(parent)
    Int alive = 1
    Int tries = 0
    while alive == 1 and tries < 200:
      alive = 0
      if Files.quietly(of3("kill", "-0", childPid)) == 0:
        alive = 1
        sleep(10)
      end
      tries = tries + 1
    end
    out("children: parent code ${parent.code()}, child gone ${yn(1 - alive)}\n")

    # A program that never stops printing is stopped.
    Job endless = new Job()
    endless.limit = 100000
    endless.start(of("yes"), "")
    last = drain(endless)
    String tail = last.get(last.len() - 1)
    Int allY = 1
    n = 0
    while n < last.len() - 1:
      String y = last.get(n)
      if y.equals("y") == 0:
        allY = 0
      end
      n = n + 1
    end
    out("limit: code ${endless.code()}, read the limit ${yn(endless.total >= 100000)}, ")
    out("not much more ${yn(endless.total <= 100000 + 262144)}, all y ${yn(allY)}\n")
    out("  last line: ${tail}\n")

    # One that will not be asked is killed.
    Job loud = new Job()
    loud.limit = 50000
    loud.start(sh("trap '' TERM; while :; do echo y; done"), "")
    began = ticks()
    last = drain(loud)
    out("limit, ignoring TERM: code ${loud.code()}, ended ${yn(ticks() - began < 10000)}\n")

    # The file is there while it runs and gone after.
    Job tidy = new Job()
    tidy.start(sh("sleep 1; echo x"), "")
    Int during = File.exists(tidy.file)
    List find = of("find")
    find.append(tidy.dir)
    find.append("-maxdepth")
    find.append("0")
    find.append("-perm")
    find.append("0700")
    find.append("-print")
    Process q = new Process()
    q.openArgs(find)
    String seen = ""
    if q.eof() == 0:
      seen = q.readLine()
    end
    while q.eof() == 0:
      String more = q.readLine()
    end
    q.finish()
    last = drain(tidy)
    out("files: while running ${yn(during)}, folder private ${yn(seen.equals(tidy.dir))}, ")
    out("file after ${yn(File.exists(tidy.file))}, folder after ${yn(Files.isDirectory(tidy.dir))}\n")

    # Descriptors come back: with room for 50, 120 jobs one after another start.
    Bytes room = new Bytes(16)
    unsafe:
      Limits.getrlimit(8, room)
      room.set(0, 50)
      room.set(1, 0)
      room.set(2, 0)
      room.set(3, 0)
      Limits.setrlimit(8, room)
    end
    Int started = 0
    Int ended = 0
    n = 0
    while n < 120:
      Job t = new Job()
      if t.start(of("true"), "") == 1:
        started = started + 1
        last = drain(t)
        if t.code() == 0:
          ended = ended + 1
        end
      end
      n = n + 1
    end
    out("120 jobs: started ${started}, ended well ${ended}\n")

    # Two at once do not mix.
    Job a = new Job()
    Job b = new Job()
    a.start(sh("echo a1; sleep 0.2; echo a2"), "")
    b.start(sh("echo b1; echo b2"), "")
    List la = new List()
    List lb = new List()
    while a.running() == 1 or b.running() == 1:
      List ga = a.poll()
      List gb = b.poll()
      n = 0
      while n < ga.len():
        la.append(ga.get(n))
        n = n + 1
      end
      n = 0
      while n < gb.len():
        lb.append(gb.get(n))
        n = n + 1
      end
      sleep(2)
    end
    out("two at once: a ${joined(la)}, b ${joined(lb)}\n")

    # The process and what it started, from a table of "pid ppid" lines with rubbish in
    # it: 10 is the root; 11 and 14 are its children, 12 is 11's; 13 is someone else's;
    # a pid of 0 is never taken, a line of words adds nothing, and 10 listed as 12's
    # child is not found a second time.
    List table = new List()
    table.append("10 1")
    table.append("11 10")
    table.append("12 11")
    table.append("13 99")
    table.append("garbage")
    table.append(" 14 10 ")
    table.append("0 10")
    table.append("10 12")
    table.append("5 5")
    table.append("x 10")
    Ints family = Job.descendants(table, 10)
    String listed = ""
    n = 0
    while n < family.len():
      if n > 0:
        listed = listed + ","
      end
      listed = listed + "${family.get(n)}"
      n = n + 1
    end
    Ints alone = Job.descendants(table, 77)
    Ints nobody = Job.descendants(new List(), 4)
    out("family: ${listed}; alone ${alone.len()} (${alone.get(0)}); empty table ${nobody.len()} (${nobody.get(0)})\n")

    # A Job is used again: nothing of the first run is left in the second.
    Job again = new Job()
    again.limit = 100000
    again.start(sh("head -c 90000 /dev/zero | tr '\\0' x; echo"), "")
    last = drain(again)
    out("again 1: code ${again.code()}, total ${again.total}, ${last.len()} lines\n")
    again.start(sh("head -c 90000 /dev/zero | tr '\\0' x; echo"), "")
    out("again 2 begins: code ${again.code()}, total ${again.total}\n")
    last = drain(again)
    out("again 2: code ${again.code()}, total ${again.total}, ${last.len()} lines\n")
    again.limit = 20000
    again.start(of("yes"), "")
    last = drain(again)
    out("again 3 (over its limit): code ${again.code()}\n")
    again.limit = 1000000
    again.start(of2("echo", "hi"), "")
    last = drain(again)
    out("again 4 (not): code ${again.code()}, ${joined(last)}\n")
    again.start(of2("sleep", "30"), "")
    again.stop()
    last = drain(again)
    out("again 5 (stopped): code ${again.code()}\n")
    again.start(of2("sleep", "30"), "")
    again.stop()
    last = drain(again)
    out("again 6 (stopped once more): code ${again.code()}\n")

    # Refused.
    Job refused = new Job()
    out("empty list: ${refused.start(new List(), "")}, running ${refused.running()}\n")
    Job busy = new Job()
    busy.start(sh("sleep 1"), "")
    out("start while running: ${busy.start(of("true"), "")}\n")
    last = drain(busy)
    out("start after it ended: ${busy.start(of2("echo", "again"), "")}\n")
    last = drain(busy)
    lines()

    # A carriage return at the end of a line is not part of it.
    run("carriage returns", sh("printf 'a\\r\\nb\\r'"), "")
    lines()

    # No poll reads more than 256 KB, however much the program has printed: 400,000
    # lines of "y" are 800 KB, and by the time of the first look it has ended and
    # been collected, but only 131,072 lines of it are read. A job that has ended but
    # still has output to give is not stopped -- its process number is free to be
    # someone else's by then.
    Job flood = new Job()
    flood.start(sh("yes | head -n 400000"), "")
    sleep(500)
    List firstPoll = flood.poll()
    out("flood: first poll gave ${firstPoll.len()} lines, running ${flood.running()}")
    flood.stop()
    out(", asked after stop ${flood.asked}")
    Int theRest = count(flood)
    out(", in all ${firstPoll.len() + theRest}\n")

    # The limit is 8 MB unless it is changed.
    Job runaway = new Job()
    runaway.start(of2("yes", "abcdefghi"), "")
    count(runaway)
    out("default limit: read it all ${yn(runaway.total >= 8388608)}, ")
    out("stopped at ${yn(runaway.total <= 8388608 + 262144)}, code ${runaway.code()}\n")

    # Stopped in the middle of a line, what was read is given, in pieces of no more
    # than 64 KB and a read.
    Job cut = new Job()
    cut.limit = 100000
    cut.start(sh("head -c 100000 /dev/zero | tr '\\0' x"), "")
    last = drain(cut)
    Int chars = 0
    Int longestPiece = 0
    n = 0
    while n < last.len() - 1:
      String piece = last.get(n)
      chars = chars + piece.len()
      if piece.len() > longestPiece:
        longestPiece = piece.len()
      end
      n = n + 1
    end
    String final = last.get(last.len() - 1)
    out("cut at the limit: pieces hold ${chars} characters, none over 81920 ${yn(longestPiece <= 81920)}, ")
    out("notice last ${yn(final.equals("[output limit reached - stopped]"))}\n")

    # Someone else collecting the program does not leave the job running for good.
    Job taken = new Job()
    taken.start(of2("sleep", "1"), "")
    Process.wait(taken.pid)
    last = drain(taken)
    out("reaped elsewhere: running ${taken.running()}, code ${taken.code()}\n")

    # Where the output goes: $TMPDIR, else /tmp, and not if that cannot be made.
    unsafe:
      Limits.setenv("TMPDIR", "", 1)
    end
    Job plain = new Job()
    plain.start(of("true"), "")
    String d1 = plain.dir
    last = drain(plain)
    out("TMPDIR empty: ${yn(d1.substr(0, 17).equals("/tmp/catmint-job-"))}, six random characters ${yn(d1.len() == 23)}\n")
    unsafe:
      Limits.setenv("TMPDIR", "/var/tmp/", 1)
    end
    Job slashed = new Job()
    slashed.start(of("true"), "")
    String d2 = slashed.dir
    last = drain(slashed)
    out("TMPDIR with a slash: ${yn(d2.substr(0, 21).equals("/var/tmp/catmint-job-"))}\n")
    unsafe:
      Limits.setenv("TMPDIR", "/no/such/dir", 1)
    end
    Job nowhere = new Job()
    out("TMPDIR nowhere: start ${nowhere.start(of("true"), "")}, running ${nowhere.running()}\n")
  end
end
