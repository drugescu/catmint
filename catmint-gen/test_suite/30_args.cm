# Command-line arguments, and writing to standard error.

class Main from IO
  def main:
    out("count " + args() + "\n")

    # Argument 0 is the program itself, so skip it.
    Int i = 1
    while i < args():
      out("arg " + i + " = " + arg(i) + "\n")
      i = i + 1
    end

    # Out of range gives an empty string rather than aborting.
    out("beyond [" + arg(999) + "]\n")

    err("this goes to standard error\n")
    out("done\n")
  end
end
