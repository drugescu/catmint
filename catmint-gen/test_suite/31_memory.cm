# Giving memory back: reference counts on the object, and free.

class Node
  Int value
  Node next
end

class Main from IO
  def main:
    Node n = new Node
    n.value = 5

    out("refs " + n.refs() + "\n")
    n.retain()
    out("after retain " + n.refs() + "\n")
    n.release()
    out("after release " + n.refs() + "\n")

    # A string literal is static: no count, and freeing it does nothing
    # rather than corrupting the heap.
    String literal = "hello"
    out("literal refs " + literal.refs() + "\n")
    literal.free()
    out("literal still " + literal + "\n")

    # Allocate and give back in a loop. The live count must come out where it
    # started, which is the whole point of having free at all.
    Int start = allocated()
    Int i = 0
    while i < 1000:
      Node t = new Node
      t.value = i
      t.free()
      i = i + 1
    end
    out("net growth " + (allocated() - start) + "\n")

    # release frees at zero, so the same loop works without free.
    Int second = allocated()
    i = 0
    while i < 1000:
      Node t = new Node
      t.release()
      i = i + 1
    end
    out("net growth again " + (allocated() - second) + "\n")

    # Strings built at run time are ordinary objects and can be given back.
    # A freshly declared String owns nothing yet, and freeing it must not
    # reach for a buffer that was never allocated.
    Int third = allocated()
    i = 0
    while i < 100:
      String empty
      empty.free()
      String s = "item " + i
      s.free()
      i = i + 1
    end
    # Not zero: 'a + b' allocates a String the program never names, so
    # nothing can free it. Manual counting cannot reach a temporary, which is
    # the argument for the compiler inserting the release itself.
    out("temporaries leak " + (allocated() - third > 0) + "\n")

    # copy gives back something of its own, so freeing both is safe.
    String original = "shared"
    String duplicate = original.copy()
    out("copy " + duplicate + " refs " + duplicate.refs() + "\n")
    duplicate.free()

    n.free()
    out("done\n")
  end
end
