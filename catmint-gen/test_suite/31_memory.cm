# Memory: reference counts, and temporaries released without being asked.

class Node
  Int value
  Node next
end

class Main from IO
  def main:
    Node n = new Node
    n.value = 5

    # Two holders: the allocation's, which the open pool will give back, and
    # the variable's.
    out("refs " + n.refs() + "\n")
    n.retain()
    out("after retain " + n.refs() + "\n")
    n.release()
    out("after release " + n.refs() + "\n")

    # A string literal is static: it has no count and is never freed.
    String literal = "hello"
    out("literal refs " + literal.refs() + "\n")
    out("literal still " + literal + "\n")

    # A loop that builds a string every time round. Nothing here frees
    # anything by hand; the pool for the loop body does it.
    Int start = allocated()
    Int i = 0
    while i < 1000:
      String s = "item " + i
      i = i + 1
    end
    out("named strings leaked " + (allocated() - start) + "\n")

    # The same, but the string is never given a name, so nothing could have
    # freed it by hand even in principle. This is the case manual counting
    # cannot reach.
    Int second = allocated()
    i = 0
    while i < 500:
      Int found = ("value " + i).indexOf("zzz")
      i = i + 1
    end
    out("unnamed strings leaked " + (allocated() - second) + "\n")

    # Objects, released when the variable holding them goes out of scope.
    Int third = allocated()
    i = 0
    while i < 100:
      Node t = new Node
      t.value = i
      i = i + 1
    end
    out("objects leaked " + (allocated() - third) + "\n")

    # A List holds a reference to each of its items, and gives them back
    # when it is itself released.
    Int fourth = allocated()
    i = 0
    while i < 100:
      List items
      items.append(new Node)
      items.append(new Node)
      i = i + 1
    end
    out("lists leaked " + (allocated() - fourth) + "\n")

    # Assigning over a field releases whatever was there, so a linked
    # structure comes apart without anything being freed by hand. Releasing
    # it by hand as well would be one release too many.
    Int fifth = allocated()
    i = 0
    while i < 100:
      n.next = new Node
      n.next = null
      i = i + 1
    end
    out("fields replaced " + (allocated() - fifth) + "\n")

    out("done\n")
  end
end
