# elif, and `else if` on one line as an alias for it.
#
# An end-terminated language cannot write `else if` the way C does, because
# the inner if needs an `end` of its own and the outer one needs another.
# Python, Ruby, Lua and sh all solve it with a dedicated keyword, and so does
# this: `elif`. `else if` on a single line lexes to the same token.
#
# Writing `else` and then `if` on the *next* line is still a nested if and
# still needs both ends, which is what every program written before this did.

class Main from IO
  def Int classify(Int n):
    if n < 0:
      return 0 - 1
    elif n == 0:
      return 0
    elif n < 10:
      return 1
    elif n < 100:
      return 2
    else
      return 3
    end
  end

  def String grade(Int score):
    if score >= 90:
      return "A"
    else if score >= 80:
      return "B"
    else if score >= 70:
      return "C"
    end
    return "F"
  end

  def Int nested(Int n):
    if n > 5:
      return 1
    else
      if n > 2:
        return 2
      else
        return 3
      end
    end
  end

  def main:
    out("${classify(0 - 5)} ${classify(0)} ${classify(7)} ${classify(55)} ${classify(1000)}\n")
    out("${grade(95)} ${grade(85)} ${grade(75)} ${grade(60)}\n")
    out("${nested(9)} ${nested(4)} ${nested(1)}\n")

    Int n = 3
    if n == 1:
      out("one\n")
    elif n == 3:
      out("three\n")
    end

    Int hits = 0
    for i in 6:
      if i == 0:
        hits = hits + 100
      elif i == 1:
        hits = hits + 10
      elif i == 2:
        hits = hits + 1
      end
    end
    out("hits ${hits}\n")
  end
end
