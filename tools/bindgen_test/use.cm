# Uses what bindgen.py generated from sample.h, against the C library built
# from sample.c: catmint must read and write every field where C does.

using sample

# int32_t * is a Ptr in the bindings; an out-parameter is a one-field struct.
extern struct Count
  Int32 value
end

class Main from IO
  def main:
    SampleRecord r
    unsafe:
      Sample.sample_fill(r)
    end
    out("tag ${r.tag} at ${r.at.x} ${r.at.y} weight ${r.weight} id ${r.id}\n")
    out("name ${r.name[0]} ${r.name[4]} ${r.name[5]} ratio ${r.ratio} color ${r.color}\n")

    Int total = 0
    unsafe:
      total = Sample.sample_sum(r)
    end
    out("sum ${total}\n")
    r.tag = 1
    r.at.x = 0
    unsafe:
      total = Sample.sample_sum(r)
    end
    out("sum after writing ${total}\n")

    SampleThing thing = null
    Int id = 0
    unsafe:
      thing = Sample.sample_make(77)
      id = Sample.sample_id(thing)
      Sample.sample_free(thing)
    end
    out("thing ${id}\n")

    SampleBits bits
    bits.bytes[0] = 1
    bits.bytes[1] = 2
    Int64 word = 0
    Int64 length = 0
    unsafe:
      word = Sample.sample_word(bits)
      length = Sample.sample_length("four")
    end
    out("word ${word} length ${length}\n")

    SampleHolder holder
    holder.last = 99
    Count c
    Int last = 0
    unsafe:
      last = Sample.sample_holder_last(holder)
      Sample.sample_count(c)
    end
    out("holder ${last} count ${c.value}\n")

    out("constants ${SampleC.SAMPLE_FLAG()} ${SampleC.SAMPLE_BIG()} ${SampleC.SAMPLE_NEG()} ${SampleC.SAMPLE_CENTERED()}\n")
    out("colors ${SampleC.SAMPLE_RED()} ${SampleC.SAMPLE_GREEN()} ${SampleC.SAMPLE_BLUE()}\n")

    # `long` was bound as the target says: Int64 on this one.
    SampleWide w
    w.a = 0 - 3
    w.b = 10
    w.c = 0 - 5000000000
    w.d = 7
    Int64 wide = 0
    String one = null
    String none = null
    Ptr copy = null
    String copied = null
    unsafe:
      wide = Sample.sample_wide_sum(w)
      # Bound as String because it was listed: the text is copied out for us.
      one = Sample.sample_name(1)
      none = Sample.sample_name(99)
      # Not listed, so a Ptr: who frees it is not in the header, and here it is
      # read with String.fromC and given back.
      copy = Sample.sample_dup("copy")
      copied = String.fromC(copy, 100)
      Sample.sample_release(copy)
    end
    out("wide ${wide}\n")
    out("name ${one} none-is-null ${none == null} dup ${copied}\n")
    out("other ${SampleC.OTHER_VALUE()}\n")
  end
end
